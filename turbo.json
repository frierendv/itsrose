{
	"$schema": "https://turborepo.dev/schema.json",
	"ui": "tui",
	"cacheMaxAge": "30s",
	"globalDependencies": [".env"],
	"globalEnv": [
		"IS_DEV",
		"LOG_LEVEL",
		"NODE_*",
		// Read by the shared tsdown preset to decide whether it emits
		// development exports or production bundles.
		"BUILDING",
		"NEXT_PHASE",
		"CI"
	],
	"tasks": {
		"build": {
			"dependsOn": ["^build"],
			"inputs": ["$TURBO_DEFAULT$", ".env*"],
			"outputs": [
				".next/**",
				"!.next/cache/**",
				"!.next/dev/**",
				"dist/**"
			]
		},
		"lint": {
			"dependsOn": ["^lint"]
		},
		"lint:fix": {
			"dependsOn": ["^lint:fix"],
			"cache": false
		},
		"typecheck": {
			"dependsOn": ["^typecheck"]
		},
		"clean": {
			"cache": false
		},
		"dev": {
			"cache": false,
			"persistent": true
		}
	}
}
