{
	"name": "@itsrose/react",
	"version": "1.0.0",
	"author": "FrierenDv",
	"type": "module",
	"license": "MIT",
	"description": "ItsRose react component, hook, and utilities library.",
	"repository": {
		"type": "git",
		"url": "https://github.com/frierendv/itsrose.git",
		"directory": "react"
	},
	"bugs": "https://github.com/frierendv/itsrose/issues",
	"homepage": "https://github.com/frierendv/itsrose#readme",
	"main": "./dist/index.mjs",
	"module": "./dist/index.mjs",
	"types": "./dist/index.d.mts",
	"files": [
		"dist"
	],
	"exports": {
		".": "./src/index.ts",
		"./components": "./src/components/index.ts",
		"./core": "./src/core/index.ts",
		"./hooks": "./src/hooks/index.ts",
		"./utils": "./src/utils/index.ts",
		"./package.json": "./package.json"
	},
	"scripts": {
		"build": "tsdown",
		"build:fast": "tsdown src",
		"clean": "rimraf dist .sonda",
		"lint": "eslint . --max-warnings 0",
		"lint:fix": "eslint . --max-warnings 0 --fix",
		"typecheck": "tsc --noEmit"
	},
	"peerDependencies": {
		"react": "catalog:",
		"react-dom": "catalog:"
	},
	"dependencies": {
		"clsx": "^2.1.1",
		"tailwind-merge": "^3.6.0",
		"tailwind-variants": "^3.3.1"
	},
	"devDependencies": {
		"@itsrose/eslint-config": "workspace:*",
		"@itsrose/tsdown-config": "workspace:*",
		"@itsrose/typescript-config": "workspace:*",
		"@types/react": "catalog:",
		"@types/react-dom": "catalog:",
		"react": "catalog:",
		"react-dom": "catalog:"
	},
	"publishConfig": {
		"exports": {
			".": "./dist/index.mjs",
			"./components": "./dist/components/index.mjs",
			"./core": "./dist/core/index.mjs",
			"./hooks": "./dist/hooks/index.mjs",
			"./utils": "./dist/utils/index.mjs",
			"./package.json": "./package.json"
		}
	}
}
