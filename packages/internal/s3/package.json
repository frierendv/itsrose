{
	"name": "@itsrose/s3",
	"version": "1.1.0",
	"author": "FrierenDv",
	"type": "module",
	"license": "MIT",
	"description": "Modern, ergonomic Cloudflare R2 storage client built on the AWS SDK for JavaScript.",
	"repository": {
		"type": "git",
		"url": "https://github.com/frierendv/itsrose.git",
		"directory": "packages/internal/s3"
	},
	"bugs": "https://github.com/frierendv/itsrose/issues",
	"homepage": "https://github.com/frierendv/itsrose#readme",
	"main": "./dist/index.js",
	"module": "./dist/index.mjs",
	"types": "./dist/index.d.ts",
	"files": [
		"dist",
		"src"
	],
	"keywords": [
		"cloudflare",
		"itsrose",
		"r2",
		"s3",
		"storage",
		"typescript"
	],
	"exports": {
		".": "./src/index.ts",
		"./package.json": "./package.json"
	},
	"scripts": {
		"build": "tsdown",
		"build:fast": "tsdown src",
		"clean": "rimraf dist .sonda",
		"lint": "eslint . --max-warnings 0",
		"lint:fix": "eslint . --max-warnings 0 --fix",
		"typecheck": "tsc --noEmit"
	},
	"dependencies": {
		"@aws-sdk/client-s3": "^3.1164.0",
		"@aws-sdk/s3-request-presigner": "^3.1164.0",
		"file-type": "^22.3.0"
	},
	"devDependencies": {
		"@itsrose/standard": "workspace:*",
		"aws-sdk-client-mock": "^4.1.0"
	},
	"publishConfig": {
		"exports": {
			".": {
				"import": "./dist/index.mjs",
				"require": "./dist/index.js"
			},
			"./package.json": "./package.json"
		}
	}
}
