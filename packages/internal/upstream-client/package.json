{
	"name": "@itsrose/upstream-client",
	"version": "1.0.0",
	"author": "FrierenDv",
	"type": "module",
	"license": "MIT",
	"description": "The one seam between the feature packages and the upstream services they call.",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/frierendv/itsrose.git",
		"directory": "packages/internal/upstream-client"
	},
	"bugs": {
		"url": "https://github.com/frierendv/itsrose/issues"
	},
	"homepage": "https://github.com/frierendv/itsrose#readme",
	"main": "./dist/index.js",
	"module": "./dist/index.mjs",
	"types": "./dist/index.d.ts",
	"files": [
		"dist",
		"src"
	],
	"keywords": [
		"client",
		"http",
		"itsrose",
		"typescript",
		"upstream"
	],
	"exports": {
		".": "./src/index.ts",
		"./package.json": "./package.json"
	},
	"scripts": {
		"build": "tsdown",
		"build:fast": "tsdown src",
		"clean": "rimraf dist .sonda",
		"lint": "eslint . --max-warnings 0",
		"lint:fix": "eslint . --max-warnings 0 --fix",
		"typecheck": "tsc --noEmit"
	},
	"dependencies": {
		"@itsrose/http-client": "workspace:*",
		"@itsrose/system": "workspace:*",
		"zod": "catalog:"
	},
	"devDependencies": {
		"@itsrose/standard": "workspace:*"
	},
	"publishConfig": {
		"exports": {
			".": {
				"import": "./dist/index.mjs",
				"require": "./dist/index.js"
			},
			"./package.json": "./package.json"
		}
	}
}
