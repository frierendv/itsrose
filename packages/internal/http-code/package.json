{
	"name": "@itsrose/http-code",
	"version": "1.0.0",
	"author": "FrierenDv",
	"type": "module",
	"license": "MIT",
	"description": "Shared API and HTTP status code maps for response modeling.",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/frierendv/itsrose.git",
		"directory": "packages/internal/http-code"
	},
	"bugs": "https://github.com/frierendv/itsrose/issues",
	"homepage": "https://github.com/frierendv/itsrose#readme",
	"main": "src/index.ts",
	"files": [
		"dist"
	],
	"keywords": [
		"http",
		"itsrose",
		"response",
		"status",
		"typescript"
	],
	"scripts": {
		"build": "tsdown",
		"build:fast": "tsdown src",
		"clean": "rimraf dist .sonda",
		"lint": "eslint . --max-warnings 0",
		"lint:fix": "eslint . --max-warnings 0 --fix",
		"postpack": "clean-package restore",
		"prepack": "clean-package",
		"typecheck": "tsc --noEmit"
	},
	"devDependencies": {
		"@itsrose/eslint-config": "workspace:*",
		"@itsrose/tsdown-config": "workspace:*",
		"@itsrose/typescript-config": "workspace:*"
	},
	"clean-package": "../../../clean-package.config.json"
}
