{
	"name": "@itsrose/logger",
	"version": "1.0.0",
	"author": "FrierenDv",
	"type": "module",
	"license": "MIT",
	"description": "Shared pino-based logger utilities for ItsRose services.",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/frierendv/itsrose.git",
		"directory": "packages/core/logger"
	},
	"bugs": "https://github.com/frierendv/itsrose/issues",
	"homepage": "https://github.com/frierendv/itsrose#readme",
	"main": "src/index.ts",
	"files": [
		"dist"
	],
	"keywords": [
		"itsrose",
		"logger",
		"pino",
		"typescript"
	],
	"scripts": {
		"build": "tsdown",
		"build:fast": "tsdown src",
		"clean": "rimraf dist .sonda",
		"lint": "eslint . --max-warnings 0",
		"lint:fix": "eslint . --max-warnings 0 --fix",
		"postpack": "clean-package restore",
		"prepack": "clean-package",
		"typecheck": "tsc --noEmit"
	},
	"dependencies": {
		"chalk": "^4.1.2",
		"pino": "^10.3.1",
		"pino-abstract-transport": "^3.0.0",
		"sonic-boom": "^4.2.1"
	},
	"devDependencies": {
		"@itsrose/eslint-config": "*",
		"@itsrose/tsdown-config": "*",
		"@itsrose/typescript-config": "*"
	},
	"clean-package": "../../../clean-package.config.json"
}
