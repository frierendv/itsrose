{
	"name": "@itsrose/api-client",
	"version": "1.0.0",
	"author": "FrierenDv",
	"type": "module",
	"license": "MIT",
	"description": "Fetch client for ItsRose API",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/frierendv/itsrose.git",
		"directory": "packages/others/api-client"
	},
	"bugs": "https://github.com/frierendv/itsrose/issues",
	"homepage": "https://github.com/frierendv/itsrose#readme",
	"main": "src/index.ts",
	"files": [
		"dist"
	],
	"keywords": [
		"api",
		"client",
		"itsrose",
		"openapi",
		"typescript"
	],
	"scripts": {
		"build": "tsdown",
		"build:fast": "tsdown src",
		"clean": "rimraf dist .sonda",
		"lint": "eslint . --max-warnings 0",
		"lint:fix": "eslint . --max-warnings 0 --fix",
		"openapi:generate": "tsx scripts/generate-openapi.ts",
		"postpack": "clean-package restore",
		"prepack": "clean-package",
		"typecheck": "tsc --noEmit"
	},
	"dependencies": {
		"@itsrose/http-client": "*"
	},
	"devDependencies": {
		"@itsrose/eslint-config": "*",
		"@itsrose/tsdown-config": "*",
		"@itsrose/typescript-config": "*",
		"openapi-typescript-helpers": "^0.1.0"
	},
	"clean-package": "../../../clean-package.config.json"
}
