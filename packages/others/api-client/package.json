{
	"name": "@itsrose/api-client",
	"version": "1.0.0",
	"author": "FrierenDv",
	"type": "module",
	"license": "MIT",
	"description": "Fetch client for ItsRose API",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/frierendv/itsrose.git",
		"directory": "packages/others/api-client"
	},
	"bugs": "https://github.com/frierendv/itsrose/issues",
	"homepage": "https://github.com/frierendv/itsrose#readme",
	"main": "./dist/index.js",
	"module": "./dist/index.mjs",
	"types": "./dist/index.d.cts",
	"files": [
		"dist"
	],
	"keywords": [
		"api",
		"client",
		"itsrose",
		"openapi",
		"typescript"
	],
	"exports": {
		".": "./src/index.ts",
		"./package.json": "./package.json"
	},
	"scripts": {
		"build": "tsdown",
		"build:fast": "tsdown src",
		"clean": "rimraf dist .sonda",
		"lint": "eslint . --max-warnings 0",
		"lint:fix": "eslint . --max-warnings 0 --fix",
		"openapi:generate": "tsx scripts/generate-openapi.ts",
		"typecheck": "tsc --noEmit"
	},
	"dependencies": {
		"@itsrose/http-client": "workspace:*"
	},
	"devDependencies": {
		"@itsrose/standard": "workspace:*",
		"openapi-typescript-helpers": "^0.1.0"
	},
	"publishConfig": {
		"exports": {
			".": {
				"import": "./dist/index.mjs",
				"require": "./dist/index.js"
			},
			"./package.json": "./package.json"
		}
	}
}
