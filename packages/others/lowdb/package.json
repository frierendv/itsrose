{
	"name": "@itsrose/lowdb",
	"version": "1.0.0",
	"author": "FrierenDv",
	"type": "module",
	"license": "MIT",
	"description": "Document-style file-backed database built on collection adapters.",
	"repository": "frierendv/itsrose.git",
	"bugs": "https://github.com/frierendv/itsrose/issues",
	"homepage": "https://github.com/frierendv/itsrose#readme",
	"main": "src/index.ts",
	"keywords": [
		"database",
		"itsrose",
		"json",
		"typescript"
	],
	"scripts": {
		"build": "tsdown",
		"build:fast": "tsdown src",
		"clean": "rimraf dist .sonda",
		"lint": "eslint . --max-warnings 0",
		"lint:fix": "eslint . --max-warnings 0 --fix",
		"openapi:generate": "tsx scripts/generate-openapi.ts",
		"postpack": "clean-package restore",
		"prepack": "clean-package",
		"typecheck": "tsc --noEmit"
	},
	"dependencies": {
		"atomically": "^2.1.1",
		"superjson": "^2.2.6"
	},
	"devDependencies": {
		"@itsrose/eslint-config": "*",
		"@itsrose/tsdown-config": "*",
		"@itsrose/typescript-config": "*"
	},
	"clean-package": "../../clean-package.config.json"
}
