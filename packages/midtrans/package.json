{
	"name": "@itsrose/midtrans",
	"version": "2.0.0",
	"author": "FrierenDv",
	"type": "module",
	"sideEffects": false,
	"license": "MIT",
	"description": "Midtrans Payment Gateway SDK with Zod validation schemas and TypeScript types.",
	"repository": {
		"type": "git",
		"url": "https://github.com/frierendv/itsrose.git",
		"directory": "packages/midtrans"
	},
	"bugs": "https://github.com/frierendv/itsrose/issues",
	"homepage": "https://github.com/frierendv/itsrose#readme",
	"main": "./dist/index.mjs",
	"module": "./dist/index.mjs",
	"types": "./dist/index.d.mts",
	"files": [
		"dist",
		"src"
	],
	"keywords": [
		"gopay",
		"itsrose",
		"midtrans",
		"payment",
		"qris",
		"shopeepay",
		"snap",
		"typescript",
		"virtual-account",
		"zod"
	],
	"exports": {
		".": "./src/index.ts",
		"./api": "./src/api/index.ts",
		"./client": "./src/client/index.ts",
		"./env": "./src/env.ts",
		"./helper": "./src/helper/index.ts",
		"./schema": "./src/schema/index.ts",
		"./typings": "./src/typings/index.ts",
		"./package.json": "./package.json"
	},
	"scripts": {
		"build": "tsdown",
		"build:fast": "tsdown src",
		"clean": "rimraf dist .sonda",
		"fixtures:capture": "node --env-file=.env.dev --import tsx tools/capture-sandbox.ts",
		"fixtures:verify": "node --import tsx tools/verify-fixtures.ts",
		"lint": "eslint . --max-warnings 0",
		"lint:fix": "eslint . --max-warnings 0 --fix",
		"typecheck": "tsc --noEmit"
	},
	"dependencies": {
		"@itsrose/http-client": "workspace:*",
		"@itsrose/system": "workspace:*",
		"zod": "catalog:"
	},
	"devDependencies": {
		"@itsrose/standard": "workspace:*",
		"axios": "catalog:"
	},
	"publishConfig": {
		"exports": {
			".": "./dist/index.mjs",
			"./api": "./dist/api.mjs",
			"./client": "./dist/client.mjs",
			"./env": "./dist/env.mjs",
			"./helper": "./dist/helper.mjs",
			"./schema": "./dist/schema.mjs",
			"./typings": "./dist/typings.mjs",
			"./package.json": "./package.json"
		}
	},
	"engines": {
		"node": ">=24"
	}
}
