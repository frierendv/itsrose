# Copy this file to `.env.dev` (which is gitignored) and fill in the sandbox
# keys from https://dashboard.sandbox.midtrans.com/settings/access-keys.
#
# `fixtures:capture` refuses to run unless the environment is `sandbox` and the
# server key starts with `SB-Mid-server-`.
MIDTRANS_ENVIRONMENT=sandbox
MIDTRANS_MERCHANT_ID=
MIDTRANS_SERVER_KEY=
MIDTRANS_CLIENT_KEY=
