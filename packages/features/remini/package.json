{
	"name": "@itsrose/remini",
	"version": "1.0.0",
	"author": "FrierenDv",
	"type": "module",
	"license": "MIT",
	"description": "Typed client for the Remini image enhancement service.",
	"repository": "frierendv/itsrose.git",
