{
	"name": "@itsrose/auth",
	"version": "1.0.0",
	"author": "FrierenDv",
	"private": true,
	"type": "module",
	"license": "MIT",
	"description": "ItsRose auth",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/frierendv/itsrose.git",
		"directory": "packages/auth"
	},
	"bugs": "https://github.com/frierendv/itsrose/issues",
	"homepage": "https://github.com/frierendv/itsrose#readme",
	"main": "./dist/index.mjs",
	"module": "./dist/index.mjs",
	"types": "./dist/index.d.mts",
	"files": [
		"dist"
	],
	"keywords": [
		"auth",
		"itsrose"
	],
	"exports": {
		".": "./src/index.ts",
		"./eusend": "./src/eusend/index.ts",
		"./itsrose": "./src/itsrose/index.ts",
		"./itsrose/client": "./src/itsrose/client/index.ts",
		"./itsrose/server": "./src/itsrose/server/index.ts",
		"./react": "./src/react/index.ts",
		"./server": "./src/server/index.ts",
		"./storage": "./src/storage/index.ts",
		"./package.json": "./package.json"
	},
	"scripts": {
		"build": "tsdown",
		"build:fast": "tsdown src",
		"clean": "rimraf dist .sonda",
		"db:generate": "pnpx auth@latest generate --config src/~auth.ts --output db/itsrose-public.sql -y",
		"db:migrate": "pnpx auth@latest migrate --config src/~auth.ts -y",
		"lint": "eslint . --max-warnings 0",
		"lint:fix": "eslint . --max-warnings 0 --fix",
		"typecheck": "tsc --noEmit"
	},
	"dependencies": {
		"@better-auth-ui/heroui": "^1.7.30",
		"@better-auth/api-key": "^1.7.7",
		"@better-auth/infra": "^0.4.17",
		"@better-auth/passkey": "^1.7.7",
		"@eusend_dev/sdk": "^0.19.0",
		"@itsrose/midtrans": "workspace:*",
		"@itsrose/s3": "workspace:*",
		"@itsrose/system": "workspace:*",
		"@react-email/render": "^2.1.1",
		"better-auth": "^1.7.7",
		"react": "catalog:",
		"react-dom": "catalog:",
		"zod": "catalog:"
	},
	"devDependencies": {
		"@itsrose/standard": "workspace:*",
		"@types/jest": "^30.0.0",
		"@types/pg": "^8.23.1",
		"@types/react": "catalog:",
		"@types/react-dom": "catalog:",
		"kysely": "^0.29.6",
		"pg": "^8.23.1"
	},
	"publishConfig": {
		"exports": {
			".": "./dist/index.mjs",
			"./eusend": "./dist/eusend/index.mjs",
			"./itsrose": "./dist/itsrose/index.mjs",
			"./itsrose/client": "./dist/itsrose/client/index.mjs",
			"./itsrose/server": "./dist/itsrose/server/index.mjs",
			"./react": "./dist/react/index.mjs",
			"./server": "./dist/server/index.mjs",
			"./storage": "./dist/storage/index.mjs",
			"./package.json": "./package.json"
		}
	}
}
