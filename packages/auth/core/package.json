{
	"name": "@itsrose/auth",
	"version": "1.0.0",
	"author": "FrierenDv",
	"private": true,
	"type": "module",
	"license": "MIT",
	"description": "ItsRose auth composition root: Better Auth server, React client, and plugin assembly.",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/frierendv/itsrose.git",
		"directory": "packages/auth/core"
	},
	"bugs": "https://github.com/frierendv/itsrose/issues",
	"homepage": "https://github.com/frierendv/itsrose#readme",
	"main": "./dist/index.mjs",
	"module": "./dist/index.mjs",
	"types": "./dist/index.d.mts",
	"files": [
		"dist",
		"src"
	],
	"keywords": [
		"auth",
		"itsrose",
		"better-auth"
	],
	"exports": {
		".": "./src/index.ts",
		"./react": "./src/react/index.ts",
		"./server": "./src/server/index.ts",
		"./package.json": "./package.json"
	},
	"scripts": {
		"build": "tsdown",
		"build:fast": "tsdown src",
		"clean": "rimraf dist .sonda",
		"db:generate": "pnpx auth@latest generate --config src/~auth.ts --output db/itsrose-public.sql -y",
		"db:migrate": "pnpx auth@latest migrate --config src/~auth.ts -y",
		"lint": "eslint . --max-warnings 0",
		"lint:fix": "eslint . --max-warnings 0 --fix",
		"typecheck": "tsc --noEmit"
	},
	"dependencies": {
		"@better-auth/api-key": "^1.7.7",
		"@better-auth/infra": "^0.4.17",
		"@better-auth/passkey": "^1.7.7",
		"@itsrose/auth-billing": "workspace:*",
		"@itsrose/auth-mailer": "workspace:*",
		"@itsrose/auth-storage": "workspace:*",
		"@itsrose/system": "workspace:*",
		"better-auth": "^1.7.7",
		"pg": "^8.23.1",
		"react": "catalog:",
		"react-dom": "catalog:"
	},
	"devDependencies": {
		"@itsrose/standard": "workspace:*",
		"@types/jest": "^30.0.0",
		"@types/node": "catalog:",
		"@types/pg": "^8.23.1",
		"@types/react": "catalog:",
		"@types/react-dom": "catalog:",
		"dotenv": "^18.0.7"
	},
	"publishConfig": {
		"exports": {
			".": "./dist/index.mjs",
			"./react": "./dist/react/index.mjs",
			"./server": "./dist/server/index.mjs",
			"./package.json": "./package.json"
		}
	}
}
