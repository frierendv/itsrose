	},
	"publishConfig": {
		"exports": {
			".": "./dist/index.mjs",
			"./client": "./dist/client.mjs",
			"./env": "./dist/env.mjs",
			"./plugin-server": "./dist/plugin-server.mjs",
			"./renderer": "./dist/renderer.mjs",
			"./service": "./dist/service.mjs",
			"./types": "./dist/types.mjs",
