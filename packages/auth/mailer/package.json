		"./plugin-server": "./src/plugin-server.ts",
		"./renderer": "./src/renderer.ts",
		"./service": "./src/service.ts",
		"./types": "./src/types.ts",
		"./package.json": "./package.json",
		"./plugin": "./src/plugin-server.ts"
	},
	"scripts": {
