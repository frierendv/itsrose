{
	"name": "@itsrose/auth-mailer",
	"version": "1.0.0",
	"author": "FrierenDv",
	"private": true,
	"type": "module",
	"license": "MIT",
	"description": "Eusend-backed transactional email service and Better Auth plugin for ItsRose.",
	"repository": {
		"type": "git",
		"url": "https://github.com/frierendv/itsrose.git",
		"directory": "packages/auth/mailer"
	},
