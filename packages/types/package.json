{
	"name": "@itsrose/types",
	"version": "1.0.0",
	"author": "FrierenDv",
	"type": "module",
	"sideEffects": false,
	"license": "MIT",
	"description": "Global, purely type-only TypeScript utility types for the ItsRose monorepo.",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/frierendv/itsrose.git",
		"directory": "packages/types"
	},
	"bugs": "https://github.com/frierendv/itsrose/issues",
	"homepage": "https://github.com/frierendv/itsrose#readme",
	"main": "./dist/index.mjs",
	"module": "./dist/index.mjs",
	"types": "./dist/index.d.ts",
	"files": [
		"dist"
	],
	"keywords": [
		"itsrose",
		"types",
		"typescript",
		"utilities"
	],
	"exports": {
		".": "./src/index.ts",
		"./package.json": "./package.json"
	},
	"scripts": {
		"build": "tsdown",
		"clean": "rimraf dist .sonda",
		"lint": "eslint . --max-warnings 0",
		"lint:fix": "eslint . --max-warnings 0 --fix",
		"typecheck": "tsc --noEmit"
	},
	"devDependencies": {
		"@itsrose/standard": "workspace:*"
	},
	"publishConfig": {
		"exports": {
			".": {
				"types": "./dist/index.d.ts",
				"import": "./dist/index.mjs"
			},
			"./package.json": "./package.json"
		}
	}
}
