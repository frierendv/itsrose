{
	"name": "@itsrose/shared-schema",
	"version": "1.0.0",
	"author": "FrierenDv",
	"type": "module",
	"license": "MIT",
	"description": "Shared Zod schemas reused across ItsRose packages.",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/frierendv/itsrose.git",
		"directory": "packages/shared/shared-schema"
	},
	"bugs": "https://github.com/frierendv/itsrose/issues",
	"homepage": "https://github.com/frierendv/itsrose#readme",
	"main": "./dist/index.js",
	"module": "./dist/index.mjs",
	"types": "./dist/index.d.cts",
	"files": [
		"dist"
	],
	"keywords": [
		"itsrose",
		"schema",
		"typescript",
		"zod"
	],
	"exports": {
		".": "./src/index.ts",
		"./package.json": "./package.json"
	},
	"scripts": {
		"build": "tsdown",
		"build:fast": "tsdown src",
		"clean": "rimraf dist .sonda",
		"lint": "eslint . --max-warnings 0",
		"lint:fix": "eslint . --max-warnings 0 --fix",
		"typecheck": "tsc --noEmit"
	},
	"dependencies": {
		"zod": "catalog:"
	},
	"devDependencies": {
		"@itsrose/standard": "workspace:*"
	},
	"publishConfig": {
		"exports": {
			".": {
				"import": "./dist/index.mjs",
				"require": "./dist/index.js"
			},
			"./package.json": "./package.json"
		}
	}
}
