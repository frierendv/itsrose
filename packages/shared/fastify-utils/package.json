{
	"name": "@itsrose/fastify-utils",
	"version": "1.0.0",
	"author": "FrierenDv",
	"type": "module",
	"license": "MIT",
	"description": "Fastify-focused shared helpers and schemas.",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/frierendv/itsrose.git",
		"directory": "packages/shared/fastify-utils"
	},
	"bugs": "https://github.com/frierendv/itsrose/issues",
	"homepage": "https://github.com/frierendv/itsrose#readme",
	"main": "./dist/index.js",
	"module": "./dist/index.mjs",
	"types": "./dist/index.d.cts",
	"files": [
		"dist"
	],
	"keywords": [
		"fastify",
		"itsrose",
		"typescript",
		"utilities"
	],
	"exports": {
		".": "./src/index.ts",
		"./package.json": "./package.json"
	},
	"scripts": {
		"build": "tsdown",
		"build:fast": "tsdown src",
		"clean": "rimraf dist .sonda",
		"lint": "eslint . --max-warnings 0",
		"lint:fix": "eslint . --max-warnings 0 --fix",
		"typecheck": "tsc --noEmit"
	},
	"dependencies": {
		"hyperid": "^4.0.0"
	},
	"devDependencies": {
		"@itsrose/eslint-config": "workspace:*",
		"@itsrose/tsdown-config": "workspace:*",
		"@itsrose/typescript-config": "workspace:*"
	},
	"publishConfig": {
		"exports": {
			".": {
				"import": "./dist/index.mjs",
				"require": "./dist/index.js"
			},
			"./package.json": "./package.json"
		}
	}
}
