{
	"$schema": "https://typedoc.org/schema.json",
	"name": "ItsRose Documentation",
	"plugin": [
		"@boneskull/typedoc-plugin-mermaid",
		"typedoc-plugin-zod",
		"typedoc-plugin-mdn-links",
		"typedoc-plugin-dt-links",
		"typedoc-plugin-hash-link-references"
	],
	"out": "./docs",
	"customCss": "./assets/css/typedoc-theme.css",
	"entryPoints": ["packages/**/*"],
	"entryPointStrategy": "packages",
	"packageOptions": {
		"entryPoints": ["src/index.ts"],
		"gitRemote": "upstream",
		"gitRevision": "development",
		"sourceLinkTemplate": "https://git.itsrose.net/itsrose/itsrose/blame/branch/{gitRevision}/{path}#L{line}"
	},
	"sourceLinkExternal": true,
	"darkHighlightTheme": "rose-pine-moon",
	"lightHighlightTheme": "rose-pine-dawn",
	"navigation": {
		"compactFolders": true,
		"includeFolders": true,
		"includeCategories": true,
		"includeGroups": false
	},
	"defaultCategory": "Others",
	"categoryOrder": ["Core", "Features", "Internal", "Shared", "*"],
	"categorizeByGroup": false,
	"searchInComments": true,
	"cleanOutputDir": true,
	"commentStyle": "all",
	"exclude": ["**/standard", "**/__tests__/**"],
	"includeVersion": true,
	"externalSymbolLinkMappings": {
		"@itsrose/logger": { "pinoTransport": "#" },
		"s3mini": { "S3mini": "#" },
		"axios": { "AxiosError": "#" }
	},
	"additionalModuleSources": ["typescript", "@types/node", "@types/jest"]
}
