{
	"editor.codeActionsOnSave": {
		"source.fixAll.eslint": "always"
	},
	"customLocalFormatters.formatters": [
		// https://github.com/reteps/dockerfmt/releases
		{ "command": "dockerfmt --newline", "languages": ["dockerfile"] },
		// https://github.com/mvdan/sh/releases
		{ "command": "shfmt", "languages": ["shellscript"] }
	],
	"editor.defaultFormatter": "esbenp.prettier-vscode",
	"editor.detectIndentation": false,
	"[typescript]": {
		"editor.defaultFormatter": "esbenp.prettier-vscode"
	},
	"jest.runMode": {
		"type": "on-demand"
	},
	"yaml.schemas": {
		"https://www.schemastore.org/github-workflow.json": [
			"/.github/workflows/*"
		]
	},
	"[dockerfile]": {
		"editor.defaultFormatter": "jkillian.custom-local-formatters"
	},
	"[dockercompose]": {
		"editor.defaultFormatter": "esbenp.prettier-vscode"
	},
	"[astro]": {
		"editor.defaultFormatter": "astro-build.astro-vscode"
	},
	"[sql]": {
		"editor.defaultFormatter": "ReneSaarsoo.sql-formatter-vsc"
	},
	"[yaml]": {
		"editor.defaultFormatter": "esbenp.prettier-vscode"
	},

	/* shell */
	"[shellscript]": {
		"editor.defaultFormatter": "jkillian.custom-local-formatters"
	},
	"shellcheck.executablePath": "shellcheck",

	"search.exclude": {
		"**/dist": true,
		"**/.next": true,
		"**/.sonda": true,
		"**/node_modules": true,
		"**/.turbo/**": true
	},
	"files.watcherExclude": {
		"**/dist/**": true,
		"**/.next/**": true,
		"**/.sonda/**": true,
		"**/node_modules/**": true,
		"**/.turbo/**": true
	},

	"chat.disableAIFeatures": true
}
