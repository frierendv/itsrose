{
	"plugins": ["@ianvs/prettier-plugin-sort-imports"],
	"printWidth": 80,
	"useTabs": true,
	"tabWidth": 4,
	"semi": true,
	"singleQuote": false,
	"quoteProps": "as-needed",
	"jsxSingleQuote": false,
	"trailingComma": "es5",
	"bracketSpacing": true,
	"arrowParens": "always",
	"endOfLine": "lf",
	"importOrder": ["^\\.\\./", "^\\./"],
	"overrides": [
		{
			"files": [
				"*.yml",
				"*.yaml",
				"docker-compose*.yml",
				"docker-compose*.yaml"
			],
			"options": {
				"tabWidth": 2,
				"useTabs": false,
				"singleQuote": false
			}
		}
	]
}
