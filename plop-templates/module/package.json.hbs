{
	"name": "@itsrose/{{name}}",
	"version": "1.0.0",
	"author": "FrierenDv",
	"type": "module",
	"license": "MIT",
	"description": "{{description}}",
	"repository": {
		"type": "git",
		"url": "https://github.com/frierendv/itsrose.git",
		"directory": "{{directory}}"
	},
	"bugs": "https://github.com/frierendv/itsrose/issues",
	"homepage": "https://github.com/frierendv/itsrose#readme",
	"main": "src/index.ts",
	"files": [
		"dist"
	],
	"scripts": {
		"build": "tsdown",
		"build:fast": "tsdown src",
