{
	"name": "itsrose",
	"version": "0.0.0",
	"private": true,
	"description": "ItsRose Platform",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/frierendv/itsrose.git"
	},
	"engines": {
		"node": ">=24"
	},
	"scripts": {
		"build": "turbo run build",
		"build:no-cache": "turbo run build --no-cache",
		"clean": "turbo run clean",
		"commitlint": "commitlint --edit",
		"dev": "turbo run dev",
		"format": "prettier --write \"**/*.{ts,tsx,md}\" --ignore-path .gitignore && syncpack format",
		"lint": "turbo run lint",
		"lint-staged": "lint-staged",
		"lint:fix": "turbo run lint:fix",
		"plop": "NODE_OPTIONS='--import tsx' plop --plopfile=plopfile.ts",
		"prepare": "husky",
		"test": "jest --verbose --runInBand --passWithNoTests",
		"typecheck": "turbo run typecheck"
	},
	"devDependencies": {
		"@boneskull/typedoc-plugin-mermaid": "^0.2.1",
		"@commitlint/cli": "^21.2.1",
		"@commitlint/config-conventional": "^21.2.0",
		"@eslint/js": "^10.0.1",
		"@ianvs/prettier-plugin-sort-imports": "^4.7.1",
		"@next/eslint-plugin-next": "^16.3.0",
		"@types/jest": "^30.0.0",
		"@types/node": "24.12.0",
		"@vercel/nft": "^1.10.2",
		"clean-package": "^2.2.0",
		"eslint": "^10.8.1",
		"eslint-config-flat-gitignore": "^2.3.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-only-warn": "^1.2.1",
		"eslint-plugin-react-hooks": "^7.1.1",
		"eslint-plugin-turbo": "^2.10.9",
		"globals": "^17.9.0",
		"husky": "^9.1.7",
		"jest": "^30.4.2",
		"jiti": "^2.7.0",
		"lint-staged": "^17.3.0",
		"plop": "^4.0.5",
		"prettier": "^3.9.6",
		"rimraf": "^6.1.3",
		"sonda": "^0.14.0",
		"syncpack": "^15.3.2",
		"ts-jest": "^29.4.12",
		"ts-node": "^10.9.2",
		"tsdown": "^0.22.14",
		"tsx": "^4.23.1",
		"turbo": "^2.10.8",
		"typedoc": "^0.28.20",
		"typedoc-plugin-dt-links": "^2.0.65",
		"typedoc-plugin-hash-link-references": "^1.0.2",
		"typedoc-plugin-mdn-links": "^5.1.1",
		"typedoc-plugin-zod": "^1.4.3",
		"typescript": "^5.9.3",
		"typescript-eslint": "^8.66.0",
		"unplugin-macros": "^0.20.2",
		"unplugin-preprocessor-directives": "^1.2.0",
		"unplugin-purge-polyfills": "^0.1.0",
		"unplugin-unused": "^0.5.7"
	},
	"packageManager": "pnpm@11.20.0+sha512.9a6f330a95b66446ea088faf1521405a8a01f07fde7124cc9958dfed52d4bb436737e65b08f85f37b46fcba375092558ac51262b816844b22f63406ed166bfee"
}
