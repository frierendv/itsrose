{
	"name": "itsrose",
	"version": "0.0.0",
	"private": true,
	"description": "ItsRose Platform",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/frierendv/itsrose.git"
	},
	"engines": {
		"node": ">=24"
	},
	"scripts": {
		"build": "turbo run build",
		"build:no-cache": "turbo run build --no-cache",
		"clean": "turbo run clean",
		"commitlint": "commitlint --edit",
		"dev": "turbo run dev",
		"format": "prettier --write \"**/*.{ts,tsx,md}\" --ignore-path .gitignore --list-different && syncpack format",
		"lint": "turbo run lint",
		"lint-staged": "lint-staged",
		"lint:fix": "turbo run lint:fix",
		"plop": "NODE_OPTIONS='--import tsx' plop --plopfile=plopfile.ts",
		"prepare": "husky",
		"sync:package": "tsx sync-package.ts",
		"test": "jest --verbose --runInBand --passWithNoTests",
		"typecheck": "turbo run typecheck"
	},
	"devDependencies": {
		"@boneskull/typedoc-plugin-mermaid": "^0.2.1",
		"@commitlint/cli": "^21.2.3",
		"@commitlint/config-conventional": "^21.2.3",
		"@commitlint/types": "^21.2.3",
		"@eslint/js": "^10.0.1",
		"@ianvs/prettier-plugin-sort-imports": "^4.7.1",
		"@next/eslint-plugin-next": "^16.3.8",
		"@rolldown/plugin-babel": "^0.2.4",
		"@testing-library/jest-dom": "^7.0.1",
		"@testing-library/react": "^16.3.3",
		"@testing-library/user-event": "^14.6.7",
		"@types/jest": "^30.0.0",
		"@types/node": "catalog:",
		"@vercel/nft": "^1.11.0",
		"@vitejs/plugin-react": "^6.1.2",
		"babel-plugin-react-compiler": "^1.0.0",
		"eslint": "^10.12.0",
		"eslint-config-flat-gitignore": "^2.4.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-only-warn": "^1.2.1",
		"eslint-plugin-react-hooks": "^7.1.1",
		"eslint-plugin-turbo": "^2.11.7",
		"globals": "^17.13.0",
		"husky": "^9.1.7",
		"jest": "^30.5.2",
		"jest-environment-jsdom": "^30.5.2",
		"jiti": "^2.7.0",
		"lint-staged": "^17.6.0",
		"plop": "^4.0.5",
		"prettier": "^3.9.10",
		"rimraf": "^6.1.3",
		"sonda": "^0.14.0",
		"syncpack": "^15.3.3",
		"ts-jest": "^29.4.14",
		"ts-node": "^10.9.2",
		"tsdown": "^0.23.1",
		"tsx": "^4.23.15",
		"turbo": "^2.11.7",
		"typedoc": "^0.28.20",
		"typedoc-plugin-dt-links": "^2.0.76",
		"typedoc-plugin-hash-link-references": "^1.0.3",
		"typedoc-plugin-mdn-links": "^5.1.1",
		"typedoc-plugin-zod": "^1.4.3",
		"typescript": "catalog:",
		"typescript-eslint": "^8.71.2",
		"unplugin-macros": "^0.23.3",
		"unplugin-preprocessor-directives": "^1.2.0",
		"unplugin-purge-polyfills": "^0.1.0",
		"unplugin-unused": "^0.6.0"
	},
	"packageManager": "pnpm@11.20.0+sha512.9a6f330a95b66446ea088faf1521405a8a01f07fde7124cc9958dfed52d4bb436737e65b08f85f37b46fcba375092558ac51262b816844b22f63406ed166bfee"
}
