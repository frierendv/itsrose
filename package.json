{
	"name": "itsrose",
	"version": "0.0.0",
	"private": true,
	"description": "ItsRose Platform",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/frierendv/itsrose.git"
	},
	"engines": {
		"node": ">=24"
	},
	"scripts": {
		"build": "turbo run build",
		"build:no-cache": "turbo run build --no-cache",
		"clean": "turbo run clean",
		"commitlint": "commitlint --edit",
		"dev": "turbo run dev",
		"format": "prettier --write \"**/*.{ts,tsx,md}\" --ignore-path .gitignore && syncpack format",
		"lint": "turbo run lint",
		"lint-staged": "lint-staged",
		"lint:fix": "turbo run lint:fix",
		"plop": "NODE_OPTIONS='--import tsx' plop --plopfile=plopfile.ts",
		"postinstall": "patch-package",
		"prepare": "husky",
		"test": "jest --verbose --runInBand --passWithNoTests",
		"typecheck": "turbo run typecheck"
	},
	"dependencies": {
		"patch-package": "^8.0.1"
	},
	"devDependencies": {
		"@boneskull/typedoc-plugin-mermaid": "^0.2.1",
		"@commitlint/cli": "^21.2.1",
		"@commitlint/config-conventional": "^21.2.0",
		"@emnapi/core": "^1.11.3",
		"@emnapi/runtime": "^1.11.3",
		"@ianvs/prettier-plugin-sort-imports": "^4.7.1",
		"@types/jest": "^30.0.0",
		"@types/node": "24.12.0",
		"@vercel/nft": "^1.10.2",
		"clean-package": "^2.2.0",
		"husky": "^9.1.7",
		"jest": "^30.4.2",
		"jiti": "^2.7.0",
		"lint-staged": "^17.1.0",
		"plop": "^4.0.5",
		"prettier": "^3.8.4",
		"rimraf": "^6.1.3",
		"syncpack": "^15.3.1",
		"ts-jest": "^29.4.11",
		"ts-node": "^10.9.2",
		"tsdown": "^0.22.3",
		"tsx": "^4.22.4",
		"turbo": "^2.9.18",
		"typedoc": "^0.28.20",
		"typedoc-plugin-dt-links": "^2.0.64",
		"typedoc-plugin-hash-link-references": "^1.0.2",
		"typedoc-plugin-mdn-links": "^5.1.1",
		"typedoc-plugin-zod": "^1.4.3",
		"typescript": "^5.9.3"
	},
	"overrides": {
		"test-exclude": "^8.0.0",
		"glob": "^13.0.0"
	},
	"packageManager": "npm@11.7.0",
	"workspaces": [
		"apps/*",
		"packages/**/*"
	]
}
