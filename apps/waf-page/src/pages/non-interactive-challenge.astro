---
import DiagnosticsBox from "../components/DiagnosticsBox.astro";
import ErrorHeader from "../components/ErrorHeader.astro";
import LoadingSpinner from "../components/LoadingSpinner.astro";
import ErrorLayout from "../layouts/ErrorLayout.astro";
---

<ErrorLayout
	title="Checking Your Browser"
	description="Automatic browser and connection verification in progress."
	headerStatusText="Automated Verification"
	headerStatusType="info"
>
	<ErrorHeader
		badge="Background Verification"
		badgeType="info"
		title="Just a Moment..."
		description="Please wait while we automatically verify your browser and network connection. You will be redirected shortly."
	/>

	<div class="challenge-card">
		<LoadingSpinner label="Performing automated security verification..." />

		<div
			class="captcha-target-wrapper"
			role="region"
			aria-label="Cloudflare Background Verification"
		>
			::CAPTCHA_BOX::
		</div>
	</div>

	<DiagnosticsBox compact={true} />
</ErrorLayout>
