---
import SiteFooter from "./SiteFooter.astro";
import "../styles/global.css";
import ItsRoseLogo from "../components/ItsRoseLogo.astro";

interface Props {
	title?: string;
	description?: string;
	headerStatusText?: string;
	headerStatusType?: "success" | "warning" | "danger" | "info";
}

const {
	title = "Service Notification",
	description = "ItsRose Network security and edge verification gateway.",
	headerStatusText = "Edge Active",
	headerStatusType = "info",
} = Astro.props;

const SITE_NAME = "ItsRose";
const fullTitle = `${title} | ${SITE_NAME}`;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta
			name="viewport"
			content="width=device-width, initial-scale=1, viewport-fit=cover"
		/>
		<meta name="robots" content="noindex, nofollow" />
		<meta name="theme-color" content="#090a0f" />
		<meta name="color-scheme" content="dark" />

		<!-- Primary Meta -->
		<title>{fullTitle}</title>
		<meta name="title" content={fullTitle} />
		<meta name="description" content={description} />

		<!-- Open Graph -->
		<meta property="og:type" content="website" />
		<meta property="og:title" content={fullTitle} />
		<meta property="og:description" content={description} />

		<!-- Icons -->
		<link rel="icon" href="/favicon.ico" sizes="48x48" />

		<!-- Slot for extra head tags if needed -->
		<slot name="head" />
	</head>

	<body>
		<div class="site-wrapper">
			<header class="site-header" role="banner">
				<div class="header-container">
					<a
						href="/"
						class="brand-link"
						aria-label="ItsRose Network Home"
					>
						<!-- Clean Rose Geometric SVG Mark -->
						<!-- <svg
							class="brand-logo-svg"
							viewBox="0 0 32 32"
							fill="none"
							xmlns="http://www.w3.org/2000/svg"
							aria-hidden="true"
						>
							<circle
								cx="16"
								cy="16"
								r="14"
								fill="#161924"
								stroke="rgba(255,255,255,0.12)"
								stroke-width="1.5"></circle>
							<path
								d="M16 7L21 11.5L19 18L16 22L13 18L11 11.5L16 7Z"
								fill="#f43f5e"
								opacity="0.9"></path>
							<circle cx="16" cy="14" r="3" fill="#ffffff"
							></circle>
						</svg> -->
						<ItsRoseLogo />
						<span class="brand-name">ItsRose Network</span>
					</a>

					<div class="header-status-badge">
						<span class={`pulse-dot ${headerStatusType}`}></span>
						<span>{headerStatusText}</span>
					</div>
				</div>
			</header>

			<main class="main-content" role="main">
				<div class="page-wrapper">
					<slot />
				</div>
			</main>

			<SiteFooter />
		</div>
	</body>
</html>
