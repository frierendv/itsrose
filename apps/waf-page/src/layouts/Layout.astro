---
import Image from "astro/components/Image.astro";
import LoadingSpinner from "../components/LoadingSpinner.astro";
import CfContentTag from "./CfContent.astro";
import SiteFooter from "./SiteFooter.astro";
import "../styles/global.css";

interface CheckpointContent {
	title?: string;
	subtitle?: string;
	description?: string;
	cfTag?: string;
	hide?: {
		subtitle?: boolean;
		description?: boolean;
	};
	loading?: boolean;
}

interface Props {
	content: CheckpointContent;
}

const {
	content: { title, subtitle, description, cfTag, hide, loading },
} = Astro.props as Props;

const SITE_NAME = "ItsRose";
const SITE_TITLE = "ItsRose Network";
const SUPPORT_EMAIL = "support@itsrose.net";
const LOGO = "https://assets.itsrose.net/itsrose/web-app-manifest-192x192.png";

const DEFAULT_TITLE = "Something Went Wrong";

const pageTitle = title ?? DEFAULT_TITLE;
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta
			name="viewport"
			content="width=device-width, initial-scale=1, viewport-fit=cover"
		/>

		<meta name="robots" content="noindex" />

		<meta
			name="theme-color"
			media="(prefers-color-scheme: light)"
			content="white"
		/>
		<meta
			name="theme-color"
			media="(prefers-color-scheme: dark)"
			content="black"
		/>

		<meta property="og:title" content={pageTitle} />
		<meta property="og:description" content={description} />

		<meta name="twitter:card" content="summary" />
		<meta name="twitter:title" content={pageTitle} />
		<meta name="twitter:description" content={description} />

		<link rel="icon" href="/favicon.ico" sizes="48x48" />

		<title>{pageTitle} | {SITE_NAME}</title>
	</head>

	<body class="site__body">
		<header class="site__header" role="banner">
			<Image
				src={LOGO}
				alt="ItsRose logo"
				width={40}
				height={40}
				loading="eager"
			/>

			<span class="site__header__title">{SITE_TITLE}</span>
		</header>

		<main class="checkpoint__container">
			<article
				class="checkpoint__content"
				aria-labelledby="checkpoint-heading"
				aria-describedby="checkpoint-description"
			>
				{
					!hide?.subtitle && (
						<div class="checkpoint__title">
							{loading && <LoadingSpinner />}
							<h1
								id="checkpoint-heading"
								class="checkpoint__heading"
							>
								{subtitle}
							</h1>
						</div>
					)
				}

				{
					!hide?.description && (
						<p
							id="checkpoint-description"
							class="checkpoint__description"
						>
							{description}
						</p>
					)
				}

				{
					cfTag ?
						<CfContentTag cfTag={cfTag} />
					:	<div style="margin-bottom: 1rem;" />
				}
			</article>
		</main>

		<SiteFooter siteName={SITE_NAME} supportEmail={SUPPORT_EMAIL} />
		<script>
			const els = {
				revealBtn: document.getElementById("cf-footer-ip-reveal"),
				ip: document.getElementById("cf-footer-ip"),
				title: document.querySelector("title"),
				details: document.querySelector(".cf-error-details"),
				heading: document.getElementById("checkpoint-heading"),
				description: document.getElementById("checkpoint-description"),
				cfFooter: document.querySelector(".footer"),
			};

			function revealIp() {
				if (!els.ip || !els.revealBtn) return;

				els.ip.classList.remove("hidden");
				els.revealBtn.hidden = true;
			}
			function deleteElement(el: Element | null) {
				if (!el) return;

				el.remove();
			}

			function copyContent(
				selector: string,
				target: HTMLElement | null,
				suffix = ""
			) {
				if (!els.details || !target) return;

				const source = els.details.querySelector(selector);
				if (!source) return;

				target.innerHTML = source.innerHTML + suffix;
			}

			els.revealBtn?.addEventListener("click", revealIp);
			deleteElement(els.cfFooter);

			copyContent("h1", els.title, " | ItsRose");
			copyContent("h1", els.heading);
			copyContent("p", els.description);

			els.details?.remove();
		</script>
	</body>
</html>
