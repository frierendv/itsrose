---
interface Props {
	siteName?: string;
	supportEmail?: string;
	statusUrl?: string;
}

const {
	siteName = "ItsRose",
	supportEmail = "support@itsrose.net",
	statusUrl = "https://status.itsrose.net",
} = Astro.props;

const currentYear = new Date().getFullYear();
---

<footer class="site-footer" role="contentinfo">
	<div class="footer-container">
		<div class="footer-meta">
			<span>&copy; {currentYear} {siteName}. All rights reserved.</span>
			<span class="cf-secured-tag">
				Secured &amp; Accelerated by
				<a
					href="https://www.cloudflare.com"
					target="_blank"
					rel="noopener noreferrer"
					aria-label="Cloudflare edge network"
				>
					Cloudflare
				</a>
			</span>
		</div>

		<div class="footer-links">
			<a
				href={`mailto:${supportEmail}?subject=Edge%20Incident%20Report`}
				class="footer-link"
				aria-label={`Contact support at ${supportEmail}`}
			>
				Contact Support
			</a>
			<a
				href={statusUrl}
				target="_blank"
				rel="noopener noreferrer"
				class="footer-link"
				aria-label="Network System Status"
			>
				System Status
			</a>
		</div>
	</div>
</footer>
