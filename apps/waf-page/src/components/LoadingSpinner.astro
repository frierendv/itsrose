---
interface Props {
	size?: number;
	label?: string;
	showText?: boolean;
}

const {
	size = 36,
	label = "Checking your connection...",
	showText = true,
} = Astro.props;
---

<div class="spinner-container" role="status" aria-label={label}>
	<div class="spinner-visual" style={`width: ${size}px; height: ${size}px;`}>
		<svg
			class="spinner-svg"
			viewBox="0 0 40 40"
			fill="none"
			xmlns="http://www.w3.org/2000/svg"
		>
			<circle
				class="spinner-track"
				cx="20"
				cy="20"
				r="16"
				stroke="currentColor"
				stroke-width="3"></circle>
			<circle
				class="spinner-head"
				cx="20"
				cy="20"
				r="16"
				stroke="currentColor"
				stroke-width="3"
				stroke-dasharray="80"
				stroke-dashoffset="60"
				stroke-linecap="round"></circle>
		</svg>
		<div class="spinner-glow"></div>
	</div>
	{showText && <span class="spinner-label">{label}</span>}
</div>

<style>
	.spinner-container {
		display: inline-flex;
		flex-direction: column;
		align-items: center;
		justify-content: center;
		gap: 0.85rem;
	}

	.spinner-visual {
		position: relative;
		display: flex;
		align-items: center;
		justify-content: center;
	}

	.spinner-svg {
		width: 100%;
		height: 100%;
		animation: cf-spin 1.1s cubic-bezier(0.5, 0.1, 0.4, 0.9) infinite;
		transform-origin: center center;
	}

	.spinner-track {
		color: rgba(244, 63, 94, 0.15);
	}

	.spinner-head {
		color: var(--color-rose, #f43f5e);
	}

	.spinner-glow {
		position: absolute;
		inset: 15%;
		border-radius: 50%;
		background: radial-gradient(
			circle,
			rgba(244, 63, 94, 0.3) 0%,
			transparent 70%
		);
		filter: blur(4px);
		pointer-events: none;
		animation: cf-pulse 2s ease-in-out infinite alternate;
	}

	.spinner-label {
		font-size: 0.85rem;
		color: var(--text-secondary, #94a3b8);
		font-weight: 500;
		letter-spacing: -0.01em;
	}

	@keyframes cf-spin {
		0% {
			transform: rotate(0deg);
		}
		100% {
			transform: rotate(360deg);
		}
	}

	@keyframes cf-pulse {
		0% {
			opacity: 0.4;
			transform: scale(0.85);
		}
		100% {
			opacity: 0.9;
			transform: scale(1.15);
		}
	}
</style>
