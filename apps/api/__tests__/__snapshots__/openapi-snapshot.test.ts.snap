                      "description": "A human-readable message providing additional information.",
                      "title": "Response message",
                      "type": "string",
                    },
                    "meta": {
                      "additionalProperties": {},
                      "default": {},
                      "description": "Additional metadata related to the response. **Do not** rely on this field for any critical information, as it may be omitted or changed without notice.",
                      "title": "Metadata",
                      "type": "object",
                    },
                    "ok": {
                      "description": "Indicates that the response represents a successful operation.",
                      "enum": [
                        true,
                      ],
                      "title": "Success indicator",
                      "type": "boolean",
                    },
                  },
                  "required": [
