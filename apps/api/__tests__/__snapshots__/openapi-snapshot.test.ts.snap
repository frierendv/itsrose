          "pcm_48000",
          "pcm_8000",
          "ulaw_8000",
          "wav_16000",
          "wav_22050",
          "wav_24000",
          "wav_32000",
          "wav_44100",
          "wav_48000",
          "wav_8000",
        ],
        "type": "string",
      },
      "ElevenLabsSpeechToSpeech": {
        "properties": {
          "file_format": {
            "description": "The format of input audio. For \`pcm_s16le_16\`, the input audio must be 16-bit PCM at a 16kHz sample rate, single channel (mono), and little-endian byte order. ",
            "enum": [
              "pcm_s16le_16",
              "other",
            ],
            "type": "string",
          },
          "model_id": {
            "description": "Identifier of the model that will be used. Use the [\`GET\` Models](#tag/elevenlabs/GET/elevenlabs/get_models) to list all the available models. And see:
 - **\`can_do_text_to_speech\`** for \`text_to_speech\`/\`text_to_dialogue\`
 - **\`can_do_voice_conversion\`** for \`speech_to_speech\`",
            "type": "string",
          },
          "output_format": {
            "allOf": [
              {
                "$ref": "#/components/schemas/ElevenLabsOutputFormat",
              },
            ],
          },
          "remove_background_noise": {
            "description": "Whether to remove background noise from the input audio. This can help improve the quality of the output audio, especially if the input audio is noisy.",
            "type": "boolean",
          },
          "seed": {
            "description": "If specified, the system attempts to sample deterministically. Determinism is not guaranteed. Must be integer between \`0\` and \`4294967295\`.",
            "maximum": 2147483647,
            "minimum": 0,
            "nullable": true,
            "type": "integer",
          },
          "voice_id": {
            "description": "ID of the voice to be used. Use the [\`GET\` Voices](#tag/elevenlabs/GET/elevenlabs/get_voices) voices endpoint list all the available voices.",
            "type": "string",
          },
          "voice_settings": {
            "allOf": [
              {
                "$ref": "#/components/schemas/ElevenLabsVoiceSetting",
              },
            ],
          },
        },
        "required": [
          "voice_id",
        ],
        "type": "object",
      },
      "ElevenLabsTextToDialogue": {
        "properties": {
          "apply_text_normalization": {
            "description": "Whether to apply text normalization to the input text.",
            "enum": [
              "auto",
              "on",
              "off",
            ],
            "type": "string",
          },
          "inputs": {
            "items": {
              "description": "A list of dialogue inputs, each containing text and a voice ID which will be converted into speech. See [here](https://elevenlabs.io/docs/api-reference/text-to-dialogue/convert#request.body.inputs) for more details.",
              "properties": {
                "text": {
                  "type": "string",
                },
                "voice_id": {
                  "description": "ID of the voice to be used. Use the [\`GET\` Voices](#tag/elevenlabs/GET/elevenlabs/get_voices) voices endpoint list all the available voices.",
                  "type": "string",
                },
              },
              "required": [
                "text",
                "voice_id",
              ],
              "type": "object",
            },
            "type": "array",
          },
          "language_code": {
            "description": "Language code (ISO 639-1) used to enforce a language for the model and text normalization.",
            "nullable": true,
            "type": "string",
          },
          "model_id": {
            "description": "Identifier of the model that will be used. Use the [\`GET\` Models](#tag/elevenlabs/GET/elevenlabs/get_models) to list all the available models. And see:
 - **\`can_do_text_to_speech\`** for \`text_to_speech\`/\`text_to_dialogue\`
 - **\`can_do_voice_conversion\`** for \`speech_to_speech\`",
            "type": "string",
          },
          "output_format": {
            "allOf": [
              {
                "$ref": "#/components/schemas/ElevenLabsOutputFormat",
              },
            ],
            "description": "The audio format of the output.",
          },
          "seed": {
            "description": "If specified, the system attempts to sample deterministically. Determinism is not guaranteed. Must be integer between \`0\` and \`4294967295\`.",
            "maximum": 2147483647,
            "minimum": 0,
            "nullable": true,
            "type": "integer",
          },
          "settings": {
            "description": "The voice settings to use for the conversion.",
            "nullable": true,
            "properties": {
              "stability": {
                "description": "Determines how stable the voice is and the randomness between each generation.",
                "maximum": 1,
                "minimum": 0,
                "nullable": true,
                "type": "number",
              },
            },
            "type": "object",
          },
        },
        "required": [
          "inputs",
        ],
        "type": "object",
      },
      "ElevenLabsTextToSpeech": {
        "properties": {
          "apply_language_text_normalization": {
            "description": "This parameter controls language text normalization. This helps with proper pronunciation of text in some supported languages. Currently only supported for \`Japanese\`.",
            "type": "boolean",
          },
          "apply_text_normalization": {
            "description": "Whether to apply text normalization to the input text.",
            "enum": [
              "auto",
              "on",
              "off",
            ],
            "type": "string",
          },
          "language_code": {
            "description": "The language code of the text. If not specified, the system will attempt to auto-detect the language.",
            "nullable": true,
            "type": "string",
          },
          "model_id": {
            "description": "Identifier of the model that will be used. Use the [\`GET\` Models](#tag/elevenlabs/GET/elevenlabs/get_models) to list all the available models. And see:
 - **\`can_do_text_to_speech\`** for \`text_to_speech\`/\`text_to_dialogue\`
 - **\`can_do_voice_conversion\`** for \`speech_to_speech\`",
            "type": "string",
          },
          "next_text": {
            "description": "The text that comes after the text of the current request.",
            "nullable": true,
            "type": "string",
          },
          "output_format": {
            "allOf": [
              {
                "$ref": "#/components/schemas/ElevenLabsOutputFormat",
              },
            ],
            "description": "The audio format of the output.",
          },
          "previous_text": {
            "description": "The text that came before the text of the current request.",
            "nullable": true,
            "type": "string",
          },
          "seed": {
            "description": "If specified, the system attempts to sample deterministically. Determinism is not guaranteed. Must be integer between \`0\` and \`4294967295\`.",
            "maximum": 2147483647,
            "minimum": 0,
            "nullable": true,
            "type": "integer",
          },
          "text": {
            "description": "The text that will get converted into speech.",
            "type": "string",
          },
          "voice_id": {
            "description": "ID of the voice to be used. Use the [\`GET\` Voices](#tag/elevenlabs/GET/elevenlabs/get_voices) voices endpoint list all the available voices.",
            "type": "string",
          },
          "voice_settings": {
            "allOf": [
              {
                "$ref": "#/components/schemas/ElevenLabsVoiceSetting",
              },
            ],
            "description": "The voice settings to use for the conversion.",
            "nullable": true,
          },
        },
        "required": [
          "text",
          "voice_id",
        ],
        "type": "object",
      },
      "ElevenLabsVoiceSetting": {
        "description": "The voice settings for the generated audio.",
        "properties": {
          "similarity_boost": {
            "description": "Determines how closely the AI should adhere to the original voice when attempting to replicate it.",
            "maximum": 1,
            "minimum": 0,
            "nullable": true,
            "type": "number",
          },
          "speed": {
            "description": "Adjusts the speed of the voice. A value of 1.0 is the default speed, while values less than 1.0 slow down the speech, and values greater than 1.0 speed it up.",
            "nullable": true,
            "type": "number",
          },
          "stability": {
            "description": "Determines how stable the voice is and the randomness between each generation.",
            "maximum": 1,
            "minimum": 0,
            "nullable": true,
            "type": "number",
          },
          "style": {
            "description": "Determines the style exaggeration of the voice.This setting attempts to amplify the style of the original speaker. It does consume additional computational resources and might increase latency if set to anything other than 0.",
            "nullable": true,
            "type": "number",
          },
          "use_speaker_boost": {
            "description": "Whether to boost the speaker's voice. This can make the voice sound louder and more prominent in the audio.",
            "nullable": true,
            "type": "boolean",
          },
        },
        "type": "object",
      },
      "ElevenLabsVoices": {
        "additionalProperties": false,
