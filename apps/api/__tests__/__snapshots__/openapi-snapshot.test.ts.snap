    "/v1/remini/create_task": {
      "post": {
        "description": "Create remini image enhance task",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "properties": {
                  "init_image": {
                    "$ref": "#/components/schemas/SharedImageSchema",
                  },
                  "pipelines": {
                    "description": "Ordered list of image processing pipelines to execute (min 1, max 5).

> [!warning] Unsuppoer mix of feature will cause an error",
                    "items": {
                      "properties": {
                        "auto_balance": {
                          "example": {
                            "auto_contrast": {
                              "contrast_intensity_coefficient": 1.5,
                            },
                          },
                          "properties": {
                            "auto_contrast": {
                              "properties": {
                                "contrast_intensity_coefficient": {
                                  "description": "Coefficient controlling contrast intensity for automatic contrast adjustment.",
                                  "maximum": 10,
                                  "minimum": 0,
                                  "type": "number",
                                },
                              },
                              "required": [
                                "contrast_intensity_coefficient",
                              ],
                              "type": "object",
                            },
                          },
                          "required": [
                            "auto_contrast",
                          ],
                          "type": "object",
                        },
                        "background_enhance": {
                          "example": {
                            "model": "shiba-strong-tensorrt",
                            "remove_color_shift": true,
                          },
                          "properties": {
                            "model": {
                              "description": "Identifier of the model used for background enhancement or upsampling.",
                              "enum": [
                                "shiba-strong-tensorrt",
                                "rhino-tensorrt",
                                "upsampler-bicubic",
                              ],
                              "type": "string",
                            },
                            "remove_color_shift": {
                              "description": "When true, removes color shifts as part of background enhancement.",
                              "type": "boolean",
                            },
                          },
                          "required": [
                            "model",
                            "remove_color_shift",
                          ],
                          "type": "object",
                        },
                        "bokeh": {
                          "example": {
                            "aperture_radius": 0.3,
                            "apply_front_bokeh": false,
                            "group_picture": true,
                            "highlights": 0.25,
                            "rescale_kernel_for_small_images": true,
                            "vivid": 0.75,
                          },
                          "properties": {
                            "aperture_radius": {
                              "description": "A normalized aperture radius for the bokeh effect. Value must be between 0 and 1.",
                              "maximum": 1,
                              "minimum": 0,
                              "type": "number",
                            },
                            "apply_front_bokeh": {
                              "description": "Flag indicating whether the bokeh effect should be applied to foreground elements.",
                              "type": "boolean",
                            },
                            "group_picture": {
                              "description": "Flag indicating if the image contains multiple subjects (group photo), which may alter face-related processing.",
                              "type": "boolean",
                            },
                            "highlights": {
                              "description": "Normalized intensity of highlights in the bokeh effect (0 to 1).",
                              "maximum": 1,
                              "minimum": 0,
                              "type": "number",
                            },
                            "rescale_kernel_for_small_images": {
                              "description": "When true, rescales the blur kernel for small images to preserve bokeh quality.",
                              "type": "boolean",
                            },
                            "vivid": {
                              "description": "Normalized vividness parameter for the bokeh effect (0 to 1).",
                              "maximum": 1,
                              "minimum": 0,
