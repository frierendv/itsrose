        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "allOf": [
                  {
                    "properties": {
                      "hair_type": {
                        "description": "Specifies the target hairstyle to apply. See Example rendered visual for more detail.",
                        "type": "string",
                      },
                    },
                    "required": [
                      "hair_type",
                    ],
                    "type": "object",
                  },
                  {
                    "$ref": "#/components/schemas/MTXxRequest",
                  },
                ],
                "title": "Versatile Hairstyle Request",
              },
            },
          },
          "required": true,
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": false,
                  "properties": {
                    "code": {
                      "description": "The numeric code representing the success status.",
                      "title": "Response code",
                      "type": "number",
                    },
                    "data": {
                      "$ref": "#/components/schemas/MTXxResponse",
                    },
                    "errors": {
                      "description": "The errors field is always null for success responses.",
                      "enum": [
                        null,
                      ],
                      "nullable": true,
                      "title": "No errors on success responses",
                      "type": "string",
                    },
