    "/v1/audio/music_compose": {
      "post": {
        "description": "Compose a song from a prompt or a composition plan.",
        "parameters": [
          {
            "description": "By default the audio response format is base64",
            "in": "header",
            "name": "response-audio-format",
            "schema": {
              "default": "base64",
              "description": "By default the audio response format is base64",
              "enum": [
                "url",
                "base64",
              ],
              "type": "string",
            },
          },
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "allOf": [
                  {
                    "properties": {
                      "model_id": {
                        "default": "music_v1",
                        "enum": [
                          "music_v1",
                          "music_v2",
                          "music_v2_5",
                        ],
                        "type": "string",
                      },
                      "output_format": {
                        "anyOf": [
                          {
                            "description": "Use “auto” (the default) to let the API pick the best format for the selected model",
                            "enum": [
                              "auto",
                            ],
                            "title": "auto",
                            "type": "string",
                          },
                          {
                            "$ref": "#/components/schemas/ElevenLabsOutputFormat",
                          },
                        ],
                        "default": "auto",
                      },
                      "sign_with_c2pa": {
                        "description": "Whether to sign the generated song with C2PA. Applicable only for mp3 files.",
                        "example": false,
                        "type": "boolean",
                      },
                      "with_timestamps": {
                        "default": false,
                        "description": "Whether to return the timestamps of the words in the generated song.",
                        "type": "boolean",
                      },
                      "with_waveform_visual": {
                        "default": false,
                        "description": "Whether to return the visual waveform of the generated song.",
                        "type": "boolean",
                      },
                    },
                    "type": "object",
                  },
                  {
                    "anyOf": [
                      {
                        "properties": {
                          "force_instrumental": {
                            "description": "If true, guarantees that the generated song will be instrumental. If false, the song may or may not be instrumental depending on the prompt.",
                            "example": false,
                            "type": "boolean",
                          },
                          "music_length_ms": {
                            "description": "The length of the song to generate in milliseconds. Used only in conjunction with \`prompt\`.",
                            "maximum": 120000,
                            "minimum": 3000,
                            "nullable": true,
                            "type": "number",
                          },
                          "prompt": {
                            "description": "A simple text prompt to generate a song from. Cannot be used in conjunction with \`composition_plan\`.",
                            "maxLength": 4100,
                            "type": "string",
                          },
                        },
                        "required": [
                          "prompt",
                        ],
                        "title": "Prompt Strategy",
                        "type": "object",
                      },
                      {
                        "properties": {
                          "composition_plan": {
                            "anyOf": [
                              {
                                "$ref": "#/components/schemas/ElevenLabsMusicCompostionPromptSchema",
                              },
                              {
                                "$ref": "#/components/schemas/ElevenLabsMusicCompositionPlanSchema",
                              },
                            ],
                            "description": "A detailed composition plan to guide music generation. Cannot be used in conjunction with \`prompt\`.",
                          },
                          "respect_sections_durations": {
                            "description": "Controls how strictly section durations in the composition_plan are enforced. Only applies to music_v1. For music_v2 and music_v2_5, section durations are always enforced and this field is ignored.",
                            "type": "boolean",
                          },
                          "seed": {
                            "description": "Random seed to initialize the music generation process. Cannot be used in conjunction with \`prompt\`.",
                            "maximum": 2147483647,
                            "minimum": 0,
                            "nullable": true,
                            "type": "integer",
                          },
                        },
                        "required": [
                          "composition_plan",
                        ],
                        "title": "Composition Plan Strategy",
                        "type": "object",
                      },
                    ],
                  },
                ],
              },
            },
          },
          "required": true,
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": false,
                  "properties": {
                    "code": {
                      "description": "The numeric code representing the success status.",
                      "title": "Response code",
                      "type": "number",
                    },
                    "data": {
                      "additionalProperties": false,
                      "properties": {
                        "audio": {
                          "description": "Audio base64",
                          "type": "string",
                        },
                        "composition_plan": {
                          "anyOf": [
                            {
                              "$ref": "#/components/schemas/ElevenLabsMusicCompostionPromptSchemaOutput",
                            },
                            {
                              "$ref": "#/components/schemas/ElevenLabsMusicCompositionPlanSchemaOutput",
                            },
                          ],
                        },
                        "song_metadata": {
                          "additionalProperties": false,
                          "description": "Song metadata; \`null\` or empty if \`composition_plan\` request passed",
                          "properties": {
                            "description": {
                              "nullable": true,
                              "type": "string",
                            },
                            "genres": {
                              "items": {
                                "type": "string",
                              },
                              "type": "array",
                            },
                            "is_explicit": {
                              "nullable": true,
                              "type": "boolean",
                            },
                            "languages": {
                              "items": {
                                "type": "string",
                              },
                              "type": "array",
                            },
                            "title": {
                              "nullable": true,
                              "type": "string",
                            },
                          },
                          "required": [
                            "genres",
                            "languages",
                          ],
                          "type": "object",
                        },
                        "waveform_visual": {
                          "items": {
                            "maximum": 9007199254740991,
                            "minimum": -9007199254740991,
                            "type": "integer",
                          },
                          "nullable": true,
                          "type": "array",
                        },
                        "words_timestamps": {
                          "items": {
                            "additionalProperties": false,
                            "properties": {
                              "end_ms": {
                                "description": "When the word ends, in milliseconds.",
                                "type": "number",
                              },
                              "start_ms": {
                                "description": "When the word starts, in milliseconds.",
                                "type": "number",
                              },
                              "word": {
                                "description": "The word.",
                                "type": "string",
                              },
                            },
                            "required": [
                              "word",
                              "start_ms",
                              "end_ms",
                            ],
                            "type": "object",
                          },
                          "nullable": true,
                          "type": "array",
                        },
                      },
                      "required": [
                        "audio",
                        "composition_plan",
                        "song_metadata",
                      ],
                      "type": "object",
                    },
                    "errors": {
                      "description": "The errors field is always null for success responses.",
                      "enum": [
                        null,
                      ],
                      "nullable": true,
                      "title": "No errors on success responses",
                      "type": "string",
                    },
                    "message": {
                      "description": "A human-readable message providing additional information.",
                      "title": "Response message",
                      "type": "string",
                    },
                    "meta": {
                      "additionalProperties": {},
                      "default": {},
                      "description": "Additional metadata related to the response. **Do not** rely on this field for any critical information, as it may be omitted or changed without notice.",
                      "title": "Metadata",
                      "type": "object",
                    },
                    "ok": {
                      "description": "Indicates that the response represents a successful operation.",
                      "enum": [
                        true,
                      ],
                      "title": "Success indicator",
                      "type": "boolean",
                    },
                  },
                  "required": [
                    "ok",
                    "code",
                    "message",
                    "data",
                    "errors",
                    "meta",
                  ],
                  "type": "object",
                },
              },
            },
            "description": "Default Response",
          },
          "4XX": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/FailureSchema",
                },
              },
            },
            "description": "Client Error",
          },
          "5XX": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/FailureSchema",
                },
              },
            },
            "description": "Server Error",
          },
        },
        "summary": "Music compose",
        "tags": [
          "Audio",
        ],
      },
    },
