                      "description": "The moderation check of the sharing.",
                      "nullable": true,
                      "properties": {
                        "captcha_checks": {
                          "description": "The checks of the CAPTCHAs.",
                          "items": {
                            "type": "number",
                          },
                          "nullable": true,
                          "type": "array",
                        },
                        "captcha_ids": {
                          "description": "The IDs of the checked CAPTCHAs.",
                          "items": {
                            "type": "string",
                          },
                          "nullable": true,
                          "type": "array",
                        },
                        "date_checked_unix": {
                          "description": "When the moderation check ran, in Unix time.",
                          "maximum": 9007199254740991,
                          "minimum": -9007199254740991,
                          "nullable": true,
                          "type": "integer",
                        },
                        "description_check": {
                          "description": "Whether the description check passed.",
                          "nullable": true,
                          "type": "boolean",
                        },
                        "description_value": {
                          "description": "The description value of the voice.",
                          "nullable": true,
                          "type": "string",
                        },
                        "name_check": {
                          "description": "Whether the name check passed.",
                          "nullable": true,
                          "type": "boolean",
                        },
                        "name_value": {
                          "description": "The name value of the voice.",
                          "nullable": true,
                          "type": "string",
                        },
                        "sample_checks": {
                          "description": "The checks of the samples.",
                          "items": {
                            "type": "number",
                          },
                          "nullable": true,
                          "type": "array",
                        },
                        "sample_ids": {
                          "description": "The IDs of the checked samples.",
                          "items": {
                            "type": "string",
                          },
                          "nullable": true,
                          "type": "array",
                        },
                      },
                      "type": "object",
                    },
                    "name": {
                      "description": "The name of the voice.",
                      "type": "string",
                    },
                    "notice_period": {
                      "description": "The notice period of the sharing, in days.",
                      "maximum": 9007199254740991,
                      "minimum": -9007199254740991,
                      "type": "integer",
                    },
                    "original_voice_id": {
                      "description": "The ID of the original voice.",
                      "type": "string",
                    },
                    "public_owner_id": {
                      "description": "The ID of the public owner.",
                      "type": "string",
                    },
                    "rate": {
                      "description": "The rate of the sharing.",
                      "nullable": true,
                      "type": "number",
                    },
                    "reader_app_enabled": {
                      "description": "Whether the voice is enabled in the reader app.",
                      "nullable": true,
                      "type": "boolean",
                    },
                    "reader_restricted_on": {
                      "description": "The resources the reader restricts the voice on.",
                      "items": {
                        "additionalProperties": {},
                        "type": "object",
                      },
                      "nullable": true,
                      "type": "array",
                    },
                    "review_message": {
                      "description": "The review message of the voice.",
                      "nullable": true,
                      "type": "string",
                    },
                    "review_status": {
                      "description": "The review status of the voice.",
                      "type": "string",
                    },
                    "status": {
                      "description": "The sharing status of the voice.",
                      "enum": [
                        "enabled",
                        "disabled",
                        "copied",
                        "copied_disabled",
                      ],
                      "type": "string",
                    },
                    "tiktok_username": {
                      "description": "The TikTok username of the voice owner.",
                      "nullable": true,
                      "type": "string",
                    },
                    "twitter_username": {
                      "description": "The Twitter/X username of the voice owner.",
                      "nullable": true,
                      "type": "string",
                    },
                    "voice_mixing_allowed": {
                      "description": "Whether the voice may be mixed.",
                      "type": "boolean",
                    },
                    "whitelisted_emails": {
                      "description": "The emails allowed to use the voice.",
                      "items": {
                        "type": "string",
                      },
                      "type": "array",
                    },
                    "youtube_username": {
                      "description": "The YouTube username of the voice owner.",
                      "nullable": true,
                      "type": "string",
                    },
                  },
                  "type": "object",
                },
                "verified_languages": {
                  "description": "Languages that have been verified for this voice.",
                  "items": {
                    "additionalProperties": {},
                    "properties": {
                      "accent": {
                        "description": "The accent of the voice, if any.",
                        "nullable": true,
                        "type": "string",
                      },
                      "language": {
                        "description": "The language of the voice.",
                        "type": "string",
                      },
                      "locale": {
                        "description": "The locale of the voice, if any.",
                        "nullable": true,
                        "type": "string",
                      },
                      "model_id": {
                        "description": "The model ID of the voice.",
                        "type": "string",
                      },
                      "preview_url": {
                        "description": "The preview URL of the voice, if any.",
                        "nullable": true,
                        "type": "string",
                      },
                    },
                    "type": "object",
                  },
                  "nullable": true,
                  "type": "array",
                },
                "voice_id": {
                  "description": "Unique identifier for the voice.",
                  "type": "string",
                },
                "voice_verification": {
                  "additionalProperties": {},
                  "description": "Verification state and history for this voice.",
                  "nullable": true,
                  "properties": {
                    "is_verified": {
                      "description": "Whether the voice is verified.",
                      "type": "boolean",
                    },
                    "language": {
                      "description": "The language of the verification.",
                      "nullable": true,
                      "type": "string",
                    },
                    "requires_verification": {
                      "description": "Whether the voice requires verification.",
                      "type": "boolean",
                    },
                    "verification_attempts": {
                      "description": "The verification attempts of the voice.",
                      "items": {
                        "additionalProperties": {},
                        "properties": {
                          "accepted": {
                            "description": "Whether the verification attempt was accepted.",
                            "type": "boolean",
                          },
                          "date_unix": {
                            "description": "The date of the attempt in Unix time.",
                            "maximum": 9007199254740991,
                            "minimum": -9007199254740991,
                            "type": "integer",
                          },
                          "levenshtein_distance": {
                            "description": "The Levenshtein distance of the verification attempt.",
                            "type": "number",
                          },
                          "recording": {
                            "additionalProperties": {},
                            "description": "The recording of the verification attempt.",
                            "nullable": true,
                            "type": "object",
                          },
                          "similarity": {
                            "description": "The similarity of the verification attempt.",
                            "type": "number",
                          },
                          "text": {
                            "description": "The text of the attempt.",
                            "type": "string",
                          },
                        },
                        "type": "object",
                      },
                      "nullable": true,
                      "type": "array",
                    },
                    "verification_attempts_count": {
                      "description": "The number of verification attempts.",
                      "maximum": 9007199254740991,
                      "minimum": -9007199254740991,
                      "type": "integer",
                    },
                    "verification_failures": {
                      "description": "The verification failures of the voice.",
                      "items": {
                        "type": "string",
                      },
                      "type": "array",
                    },
                  },
                  "type": "object",
                },
              },
              "required": [
                "voice_id",
                "name",
                "category",
                "fine_tuning",
                "labels",
                "description",
                "preview_url",
                "available_for_tiers",
                "settings",
                "sharing",
                "high_quality_base_model_ids",
                "verified_languages",
                "voice_verification",
                "is_owner",
                "is_legacy",
                "is_mixed",
              ],
              "type": "object",
            },
            "type": "array",
          },
        },
        "required": [
          "voices",
        ],
        "type": "object",
      },
      "FailureSchema": {
        "additionalProperties": false,
        "description": "Representing a failed response.",
        "properties": {
          "code": {
            "description": "The numeric code representing the failure status.",
            "title": "Response code",
            "type": "number",
          },
          "data": {
            "description": "The data field is always null for failure responses.",
            "enum": [
              null,
            ],
            "nullable": true,
            "title": "No data on failure responses",
            "type": "string",
          },
          "errors": {
            "additionalProperties": {},
            "default": {},
            "description": "The errors field contains details about the failure. It is optional and may be omitted if no additional error information is provided.",
            "title": "Error details",
            "type": "object",
          },
          "message": {
            "description": "A human-readable message providing additional information.",
            "title": "Response message",
            "type": "string",
          },
          "meta": {
            "additionalProperties": {},
            "default": {},
            "description": "Additional metadata related to the response. **Do not** rely on this field for any critical information, as it may be omitted or changed without notice.",
            "title": "Metadata",
            "type": "object",
          },
          "ok": {
            "description": "Indicates that the response represents a failed operation.",
            "enum": [
              false,
            ],
            "title": "Failure indicator",
            "type": "boolean",
          },
        },
        "required": [
          "ok",
          "code",
          "message",
          "data",
          "errors",
          "meta",
        ],
        "title": "Failure Response Schema",
        "type": "object",
      },
      "FileBuffer": {
        "contentEncoding": "binary",
        "description": "File as a binary buffer. Only used for multipart/form-data.",
        "format": "binary",
        "type": "string",
      },
      "MTXxOutpaintingBaseRequest": {
        "properties": {
          "extra_prompt": {
            "description": "Supplementary text prompt to guide the outpainting generation. Only English is supported. Separate multiple prompt keywords with a comma (\`,\`).",
            "type": "string",
          },
          "high_quality_encode": {
            "description": "When \`true\`, the output image is encoded with high-quality, low-compression settings, producing larger file sizes but preserving finer details and reducing artifacts.",
            "type": "boolean",
          },
          "init_image": {
            "$ref": "#/components/schemas/SharedImageSchema",
          },
          "seed": {
            "description": "Controls the randomness of the generation. Use a fixed value to reproduce the same result across requests. Set to \`-1\` to use a random seed on each request.",
            "maximum": 65535,
            "minimum": -1,
            "type": "integer",
          },
          "sync_timeout": {
            "description": "**Synchronized waiting timeout (seconds).**

\`-1\` means no waiting, the API returns immediately. Default \`30\`.

> [!tip]
 > It is recommended to use the Task Query",
            "example": 30,
            "maximum": 60,
            "minimum": -1,
            "type": "number",
          },
        },
        "required": [
          "init_image",
          "sync_timeout",
        ],
        "type": "object",
      },
      "MTXxRequest": {
        "properties": {
          "init_image": {
            "$ref": "#/components/schemas/SharedImageSchema",
          },
          "sync_timeout": {
            "description": "**Synchronized waiting timeout (seconds).**

\`-1\` means no waiting, the API returns immediately. Default \`30\`.

> [!tip]
 > It is recommended to use the Task Query",
            "example": 30,
            "maximum": 60,
            "minimum": -1,
            "type": "number",
          },
        },
        "required": [
          "init_image",
          "sync_timeout",
        ],
        "type": "object",
      },
      "MTXxResponse": {
        "additionalProperties": {},
        "description": "The response schema for MTXx API.",
        "properties": {
          "media_list": {
            "description": "Output media list",
            "items": {
              "type": "string",
            },
            "type": "array",
          },
          "status": {
            "description": "Task status",
            "enum": [
              "not_started",
              "in_progress",
              "completed",
              "failed",
            ],
            "type": "string",
          },
          "task_id": {
            "description": "Task Unique Identifier",
            "type": "string",
          },
        },
        "required": [
          "status",
          "task_id",
          "media_list",
        ],
        "type": "object",
      },
      "PixverseImageToVideoRequest": {
        "description": "An image-to-video creation request.",
        "properties": {
          "aspect_ratio": {
            "description": "Aspect ratio of the output.",
            "enum": [
              "16:9",
              "9:16",
              "4:3",
              "3:4",
              "1:1",
              "2:3",
              "3:2",
              "21:9",
            ],
            "type": "string",
          },
          "duration": {
            "description": "Video duration in seconds, from 1 to 15.",
            "maximum": 15,
            "minimum": 1,
            "type": "integer",
          },
          "generate_audio_switch": {
            "description": "Generate an audio track alongside the video.",
            "type": "boolean",
          },
          "generate_multi_clip_switch": {
            "description": "Generate a multi-clip video.",
            "type": "boolean",
          },
          "img_id": {
            "description": "Image returned by POST /openapi/v2/image/upload.",
            "maximum": 9007199254740991,
            "minimum": -9007199254740991,
            "type": "integer",
          },
          "img_ids": {
            "description": "Ordered images a template task consumes.",
            "items": {
              "maximum": 9007199254740991,
              "minimum": -9007199254740991,
              "type": "integer",
            },
            "type": "array",
          },
          "model": {
            "description": "Model used to render the video.",
            "enum": [
              "v6-max",
              "c1",
              "v6",
              "v3.5",
              "v4",
              "v4.5",
              "v5",
              "v5-fast",
              "v5.5",
              "v5.6",
            ],
            "type": "string",
          },
          "prompt": {
            "description": "Description of the scene to generate.",
            "maxLength": 5000,
            "minLength": 1,
            "type": "string",
          },
          "quality": {
            "description": "Output resolution.",
            "enum": [
              "360p",
              "540p",
              "720p",
              "1080p",
            ],
            "type": "string",
          },
          "seed": {
            "description": "Seed used to make a generation reproducible.",
            "maximum": 2147483647,
            "minimum": 0,
            "type": "integer",
          },
          "template_id": {
            "description": "Template the task is created from.",
            "maximum": 9007199254740991,
            "minimum": -9007199254740991,
            "type": "integer",
          },
          "webhook_id": {
            "description": "Identifier of a webhook registered in the PixVerse console.",
            "type": "string",
          },
        },
        "required": [
          "model",
          "prompt",
          "duration",
          "quality",
          "aspect_ratio",
        ],
        "type": "object",
      },
      "PixverseTaskCreatedResponse": {
        "additionalProperties": false,
        "description": "The response schema for an accepted PixVerse task.",
        "properties": {
          "credits": {
            "description": "Credits the task is expected to consume.",
            "type": "number",
          },
          "status": {
            "description": "Task status; a freshly created task is in progress.",
            "enum": [
              "in_progress",
            ],
            "type": "string",
          },
          "task_id": {
            "description": "Task Identifier.",
            "type": "string",
          },
        },
        "required": [
          "status",
          "task_id",
          "credits",
        ],
        "type": "object",
      },
      "PixverseTaskError": {
        "additionalProperties": false,
        "properties": {
          "message": {
            "description": "Human-readable description of the failure.",
            "type": "string",
          },
          "type": {
            "description": "What failed the task.",
            "enum": [
              "moderation",
              "generation",
            ],
            "type": "string",
          },
        },
        "required": [
          "type",
          "message",
        ],
        "type": "object",
      },
      "PixverseTaskResponse": {
        "additionalProperties": false,
        "description": "The response schema for PixVerse tasks.",
        "properties": {
          "aspect_ratio": {
            "description": "Aspect ratio of the output.",
            "type": "string",
          },
          "created_at": {
            "description": "Creation time, ISO 8601.",
            "type": "string",
          },
          "credits": {
            "description": "Credits the task consumed.",
            "type": "number",
          },
          "duration": {
            "description": "Duration, in seconds.",
            "type": "number",
          },
          "error": {
            "allOf": [
              {
                "$ref": "#/components/schemas/PixverseTaskError",
              },
            ],
            "description": "Why the task failed; present only when it failed.",
          },
          "has_audio": {
            "description": "Whether the output carries audio.",
            "type": "boolean",
          },
          "media_list": {
            "description": "Output media; empty until the task completes.",
            "items": {
              "type": "string",
            },
            "type": "array",
          },
          "modified_at": {
            "description": "Last update time, ISO 8601.",
            "type": "string",
          },
          "negative_prompt": {
            "description": "Negative prompt the task was created with.",
            "type": "string",
          },
          "prompt": {
            "description": "Prompt the task was created with.",
            "type": "string",
          },
          "quality": {
            "description": "Resolution of the output.",
            "type": "string",
          },
          "seed": {
            "description": "Seed the render used.",
            "type": "number",
          },
          "status": {
            "description": "Task status.",
            "enum": [
              "not_started",
              "in_progress",
              "completed",
              "failed",
            ],
            "type": "string",
          },
          "task_id": {
            "description": "Task Identifier.",
            "type": "string",
          },
        },
        "required": [
          "status",
          "task_id",
          "media_list",
          "prompt",
          "negative_prompt",
          "has_audio",
          "created_at",
          "modified_at",
        ],
        "type": "object",
      },
      "PixverseTextToVideoRequest": {
        "description": "A text-to-video creation request.",
        "properties": {
          "aspect_ratio": {
            "description": "Aspect ratio of the output.",
            "enum": [
              "16:9",
              "9:16",
              "4:3",
              "3:4",
              "1:1",
              "2:3",
              "3:2",
              "21:9",
            ],
            "type": "string",
          },
          "duration": {
            "description": "Video duration in seconds, from 1 to 15.",
            "maximum": 15,
            "minimum": 1,
            "type": "integer",
          },
          "generate_audio_switch": {
            "description": "Generate an audio track alongside the video.",
            "type": "boolean",
          },
          "generate_multi_clip_switch": {
            "description": "Generate a multi-clip video.",
            "type": "boolean",
          },
          "model": {
            "description": "Model used to render the video.",
            "enum": [
              "v6-max",
              "c1",
              "v6",
              "v3.5",
              "v4",
              "v4.5",
              "v5",
              "v5-fast",
              "v5.5",
              "v5.6",
            ],
            "type": "string",
          },
          "prompt": {
            "description": "Description of the scene to generate.",
            "maxLength": 5000,
            "minLength": 1,
            "type": "string",
          },
          "quality": {
            "description": "Output resolution.",
            "enum": [
              "360p",
              "540p",
              "720p",
              "1080p",
            ],
            "type": "string",
          },
          "seed": {
            "description": "Seed used to make a generation reproducible.",
            "maximum": 2147483647,
            "minimum": 0,
            "type": "integer",
          },
          "webhook_id": {
            "description": "Identifier of a webhook registered in the PixVerse console.",
            "type": "string",
          },
        },
        "required": [
          "model",
          "prompt",
          "duration",
          "quality",
          "aspect_ratio",
        ],
        "type": "object",
      },
      "SharedImageSchema": {
        "anyOf": [
          {
            "format": "uri",
            "title": "url",
            "type": "string",
          },
          {
            "contentEncoding": "base64",
            "format": "base64",
            "pattern": "^$|^(?:[0-9a-zA-Z+/]{4})*(?:(?:[0-9a-zA-Z+/]{2}==)|(?:[0-9a-zA-Z+/]{3}=))?$",
            "title": "base64",
            "type": "string",
          },
        ],
        "description": "The URL or base64 string of the image to be used as the initial image.",
        "example": "https://assets.itsrose.my.id/public-resource/girl-in-red-dress.jpg",
      },
    },
  },
  "info": {
    "description": "API documentation for ItsRose services",
    "title": "ItsRose API",
    "version": "1.0.0",
  },
  "openapi": "3.0.3",
  "paths": {
    "/v1/audio/create_clone_voice": {
      "post": {
        "description": "Create a voice clone",
        "requestBody": {
          "content": {
            "multipart/form-data": {
              "schema": {
                "$ref": "#/components/schemas/ElevenLabsCreateIVCVoice",
              },
            },
          },
          "required": true,
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": false,
                  "properties": {
                    "code": {
                      "description": "The numeric code representing the success status.",
                      "title": "Response code",
                      "type": "number",
                    },
                    "data": {
                      "additionalProperties": false,
                      "properties": {
                        "requires_verification": {
                          "description": "Whether the voice requires verification",
                          "type": "boolean",
                        },
                        "voice_id": {
                          "description": "The unique identifier for the created voice.",
                          "type": "string",
                        },
                      },
                      "required": [
                        "voice_id",
                        "requires_verification",
                      ],
                      "type": "object",
                    },
                    "errors": {
                      "description": "The errors field is always null for success responses.",
                      "enum": [
                        null,
                      ],
                      "nullable": true,
                      "title": "No errors on success responses",
                      "type": "string",
                    },
                    "message": {
                      "description": "A human-readable message providing additional information.",
                      "title": "Response message",
                      "type": "string",
                    },
                    "meta": {
                      "additionalProperties": {},
                      "default": {},
                      "description": "Additional metadata related to the response. **Do not** rely on this field for any critical information, as it may be omitted or changed without notice.",
                      "title": "Metadata",
                      "type": "object",
                    },
                    "ok": {
                      "description": "Indicates that the response represents a successful operation.",
                      "enum": [
                        true,
                      ],
                      "title": "Success indicator",
                      "type": "boolean",
                    },
                  },
                  "required": [
                    "ok",
                    "code",
                    "message",
                    "data",
                    "errors",
                    "meta",
                  ],
                  "type": "object",
                },
              },
            },
            "description": "Default Response",
          },
          "4XX": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/FailureSchema",
                },
              },
            },
            "description": "Client Error",
          },
          "5XX": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/FailureSchema",
                },
              },
            },
            "description": "Server Error",
          },
        },
        "summary": "Create Clone Voice",
        "tags": [
          "Audio",
        ],
      },
    },
    "/v1/audio/get_models": {
      "get": {
        "description": "Get available models",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": false,
                  "properties": {
                    "code": {
                      "description": "The numeric code representing the success status.",
                      "title": "Response code",
                      "type": "number",
                    },
                    "data": {
                      "$ref": "#/components/schemas/ElevenLabsModels",
                    },
                    "errors": {
                      "description": "The errors field is always null for success responses.",
                      "enum": [
                        null,
                      ],
                      "nullable": true,
                      "title": "No errors on success responses",
                      "type": "string",
                    },
                    "message": {
                      "description": "A human-readable message providing additional information.",
                      "title": "Response message",
                      "type": "string",
                    },
                    "meta": {
                      "additionalProperties": {},
