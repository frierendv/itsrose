                                  "glasses",
                                  "top",
                                  "dress",
                                  "coat",
                                  "socks",
                                  "pants",
                                  "skin",
                                  "scarf etc.",
                                  "skirt",
                                  "face",
                                  "shoes",
                                  "bag",
                                  "accessories",
                                  "jumpsuit",
                                  "mannequin_stand",
                                ],
                                "type": "string",
                              },
                              "n_label": {
                                "description": "Numeric label for the segmented clothing item",
                                "type": "string",
