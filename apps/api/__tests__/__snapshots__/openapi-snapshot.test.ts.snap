                              "url",
                            ],
                            "type": "object",
                          },
                          "type": "array",
                        },
                        "segmentation_mask": {
                          "description": "Array of segmentation mask URLs",
                          "items": {
                            "format": "uri",
                            "type": "string",
                          },
                          "type": "array",
                        },
                      },
