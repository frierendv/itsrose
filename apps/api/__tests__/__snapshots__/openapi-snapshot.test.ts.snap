                        "description": "Lips cooler interface flag (0: Default, 1: Enabled)",
                        "maximum": 1,
                        "minimum": 0,
                        "type": "integer",
                      },
                      "smile_mode": {
                        "description": "Smile mode:

- 0: Laughing
- 1: Smile
- 2: Pursed lips smile
- 3: Cool
- 4: Classic smile with dimples
- 5: Dimples secondary effect",
                        "maximum": 5,
                        "minimum": 0,
                        "type": "integer",
                      },
                      "wb_flag": {
                        "description": "White balance post-processing flag (0: Disabled, 1: Enabled)",
                        "maximum": 1,
                        "minimum": 0,
                        "type": "integer",
                      },
                    },
                    "required": [
                      "smile_mode",
                    ],
                    "type": "object",
                  },
