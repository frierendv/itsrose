    "/v1/audio/get_voices": {
      "get": {
        "description": "Get available voices",
        "parameters": [
          {
            "in": "query",
            "name": "next_page_token",
            "schema": {
              "description": "The next page token to use for pagination. Returned from the previous request. Use this in combination with the \`has_more\` flag for reliable pagination.",
              "nullable": true,
              "type": "string",
            },
          },
          {
            "in": "query",
            "name": "page_size",
            "schema": {
              "description": "How many voices to return at maximum. Can not exceed \`100\`, defaults to \`10\`. ",
              "exclusiveMinimum": true,
              "maximum": 100,
              "minimum": 0,
              "type": "integer",
            },
          },
          {
            "in": "query",
            "name": "search",
            "schema": {
              "description": "Search term to filter voices by. Searches in \`name\`, \`description\`, \`labels\` and \`category\`.",
              "nullable": true,
              "type": "string",
            },
          },
          {
            "in": "query",
            "name": "sort",
            "schema": {
              "description": "Sort order of the returned voices.",
              "enum": [
                "name",
                "created_at_unix",
              ],
              "nullable": true,
              "type": "string",
            },
          },
          {
            "in": "query",
            "name": "sort_direction",
            "schema": {
              "description": "Direction of the sorting.",
              "enum": [
                "asc",
                "desc",
              ],
              "nullable": true,
              "type": "string",
            },
          },
          {
            "in": "query",
            "name": "voice_type",
            "schema": {
              "description": "Filter voices by type.",
              "enum": [
                "personal",
                "community",
                "default",
                "workspace",
                "non-default",
                "non-community",
                "saved",
              ],
              "nullable": true,
              "type": "string",
            },
          },
          {
            "in": "query",
            "name": "category",
            "schema": {
              "description": "Category of the voice to filter by.",
              "enum": [
                "premade",
                "cloned",
                "generated",
                "professional",
              ],
              "nullable": true,
              "type": "string",
            },
          },
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": false,
                  "properties": {
                    "code": {
                      "description": "The numeric code representing the success status.",
                      "title": "Response code",
                      "type": "number",
                    },
                    "data": {
                      "$ref": "#/components/schemas/ElevenLabsVoices",
                    },
                    "errors": {
                      "description": "The errors field is always null for success responses.",
                      "enum": [
                        null,
                      ],
                      "nullable": true,
                      "title": "No errors on success responses",
                      "type": "string",
                    },
                    "message": {
                      "description": "A human-readable message providing additional information.",
                      "title": "Response message",
                      "type": "string",
                    },
                    "meta": {
                      "additionalProperties": {},
                      "default": {},
                      "description": "Additional metadata related to the response. **Do not** rely on this field for any critical information, as it may be omitted or changed without notice.",
                      "title": "Metadata",
                      "type": "object",
                    },
                    "ok": {
                      "description": "Indicates that the response represents a successful operation.",
                      "enum": [
                        true,
                      ],
                      "title": "Success indicator",
                      "type": "boolean",
                    },
                  },
                  "required": [
