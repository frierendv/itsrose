    "/v1/mtxx/outpainting": {
      "post": {
        "description": "
Extends an image beyond its original canvas using AI outpainting.

<details>
	<summary>Example</summary>

| Original Image | Result Image |
|----------------|--------------------|
| ![Original Image](https://assets.itsrose.net/public-resource/girl-in-red-dress.jpg "Original Image") | ![Result Image](https://assets.itsrose.net/public-resource/girl-in-red-dress_outpainting_0_1.jpg "Expand 120% of original") |
| **Original** | **120% of original** |

</details>
",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "anyOf": [
                  {
                    "allOf": [
                      {
                        "properties": {
                          "expand_ratio": {
                            "description": "Accepts a value between \`0.0\` and \`1.0\` in increments of \`0.1\`.

The final canvas size is calculated as: \`original_size × (1 + ratio × 2)\`.

| Value | Width & Height Scale |
|-------|----------------------|
| \`0.1\` | 120% of original     |
| \`0.3\` | 160% of original     |
| \`0.5\` | 200% of original     |
| \`1.0\` | 300% of original     |",
                            "maximum": 1,
                            "minimum": 0,
                            "multipleOf": 0.1,
                            "type": "number",
                          },
                        },
                        "required": [
                          "expand_ratio",
                        ],
                        "type": "object",
                      },
                      {
                        "$ref": "#/components/schemas/MTXxOutpaintingBaseRequest",
                      },
                    ],
                    "description": "Expands the image canvas uniformly on all sides using a single ratio value.",
                    "title": "Uniform Expand Ratio",
                  },
                  {
                    "allOf": [
                      {
                        "properties": {
                          "free_expand_ratio": {
                            "description": "Defines independent expansion ratios for each side of the image. 
- \`left\` and \`right\` are proportional to the original width. 
- \`top\` and \`bottom\` are proportional to the original height.",
                            "properties": {
                              "bottom": {
                                "description": "Expansion ratio for the bottom side. Range: \`0.0\` – \`1.0\`.",
                                "maximum": 1,
                                "minimum": 0,
                                "multipleOf": 0.1,
                                "type": "number",
                              },
                              "left": {
                                "description": "Expansion ratio for the left side. Range: \`0.0\` – \`1.0\`.",
                                "maximum": 1,
                                "minimum": 0,
                                "multipleOf": 0.1,
                                "type": "number",
                              },
                              "right": {
                                "description": "Expansion ratio for the right side. Range: \`0.0\` – \`1.0\`.",
                                "maximum": 1,
                                "minimum": 0,
                                "multipleOf": 0.1,
                                "type": "number",
                              },
                              "top": {
                                "description": "Expansion ratio for the top side. Range: \`0.0\` – \`1.0\`.",
                                "maximum": 1,
                                "minimum": 0,
                                "multipleOf": 0.1,
                                "type": "number",
                              },
                            },
                            "required": [
                              "left",
                              "right",
                              "top",
                              "bottom",
                            ],
                            "title": "Per-Side Expansion Ratios",
                            "type": "object",
                          },
                        },
                        "required": [
                          "free_expand_ratio",
                        ],
                        "type": "object",
                      },
                      {
                        "$ref": "#/components/schemas/MTXxOutpaintingBaseRequest",
                      },
                    ],
                    "description": "Expands the image canvas independently on each side using per-side ratio values. Use this when the subject is off-center or asymmetric padding is required.",
                    "title": "Free Expand Ratio",
                  },
                  {
                    "allOf": [
                      {
                        "properties": {
                          "free_expand_pixel": {
                            "description": "Defines the exact number of pixels to add to each side of the image canvas. Provides pixel-level precision for layouts where exact output dimensions are required.",
                            "properties": {
                              "bottom": {
                                "description": "Pixels to add to the bottom side. Range: \`0\` – \`2048\`.",
                                "maximum": 2048,
                                "minimum": 0,
                                "type": "integer",
                              },
                              "left": {
                                "description": "Pixels to add to the left side. Range: \`0\` – \`2048\`.",
                                "maximum": 2048,
                                "minimum": 0,
                                "type": "integer",
                              },
                              "right": {
                                "description": "Pixels to add to the right side. Range: \`0\` – \`2048\`.",
                                "maximum": 2048,
                                "minimum": 0,
                                "type": "integer",
                              },
                              "top": {
                                "description": "Pixels to add to the top side. Range: \`0\` – \`2048\`.",
                                "maximum": 2048,
                                "minimum": 0,
                                "type": "integer",
                              },
                            },
                            "required": [
                              "left",
                              "right",
                              "top",
                              "bottom",
                            ],
                            "title": "Per-Side Expansion Pixels",
                            "type": "object",
                          },
                        },
                        "required": [
                          "free_expand_pixel",
                        ],
                        "type": "object",
                      },
                      {
                        "$ref": "#/components/schemas/MTXxOutpaintingBaseRequest",
                      },
                    ],
                    "description": "Expands the image canvas by an absolute pixel count on each side. Use this when you need precise control over the output image dimensions.",
                    "title": "Free Expand Pixel",
                  },
                ],
                "title": "Outpainting Request",
              },
            },
          },
          "required": true,
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": false,
                  "properties": {
                    "code": {
                      "description": "The numeric code representing the success status.",
                      "title": "Response code",
                      "type": "number",
                    },
                    "data": {
                      "$ref": "#/components/schemas/MTXxResponse",
                    },
                    "errors": {
                      "description": "The errors field is always null for success responses.",
                      "enum": [
                        null,
                      ],
                      "nullable": true,
                      "title": "No errors on success responses",
                      "type": "string",
                    },
                    "message": {
                      "description": "A human-readable message providing additional information.",
                      "title": "Response message",
                      "type": "string",
                    },
                    "meta": {
                      "additionalProperties": {},
                      "default": {},
                      "description": "Additional metadata related to the response. **Do not** rely on this field for any critical information, as it may be omitted or changed without notice.",
                      "title": "Metadata",
                      "type": "object",
                    },
                    "ok": {
                      "description": "Indicates that the response represents a successful operation.",
                      "enum": [
                        true,
                      ],
                      "title": "Success indicator",
                      "type": "boolean",
                    },
                  },
                  "required": [
                    "ok",
                    "code",
                    "message",
                    "data",
                    "errors",
                    "meta",
                  ],
                  "type": "object",
                },
              },
            },
            "description": "Default Response",
          },
          "4XX": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/FailureSchema",
                },
              },
            },
            "description": "Client Error",
          },
          "5XX": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/FailureSchema",
                },
              },
            },
            "description": "Server Error",
          },
        },
        "summary": "Outpainting",
        "tags": [
          "Mtxx",
        ],
      },
    },
