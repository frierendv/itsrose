# ItsRose API environment
#
# Copy to `.env` (gitignored) and fill in real values.
# [required] variables must be set or the API refuses to boot.
# [feature]  variables are required because the route autoload imports every
#            upstream client; supply real credentials or placeholders.
# Optional integrations degrade gracefully when the whole group is unset.

# ---------------------------------------------------------------------------
# Runtime
# ---------------------------------------------------------------------------
NODE_ENV=development
PORT=3000

# ---------------------------------------------------------------------------
# Database (Postgres)                    [required]
# Schema: pnpm --filter @itsrose/auth db:generate && db:migrate
# ---------------------------------------------------------------------------
DB_NAME=
DB_USER=
DB_PASS=
DB_HOST=127.0.0.1
DB_PORT=5432
DB_SSL=false

# ---------------------------------------------------------------------------
# Redis (cache, auth secondary storage, metering counters)   [required]
# ---------------------------------------------------------------------------
REDIS_URL=redis://127.0.0.1:6379

# ---------------------------------------------------------------------------
# Better Auth                            [required: secret]
# ---------------------------------------------------------------------------
BETTER_AUTH_SECRET=
BETTER_AUTH_BASE_URL=http://localhost:3000
APP_BASE_URL=http://localhost:3000
APP_NAME=ItsRose
APP_DOMAIN=
ROOT_DOMAIN=
# Optional: @better-auth/infra dashboard
BETTER_AUTH_API_KEY=

# ---------------------------------------------------------------------------
# OAuth (optional; set both halves of a pair or neither)
# Canonical Google names; BETTER_GOOGLE_CLIENT_ID/_SECRET are still read as
# legacy fallbacks.
# ---------------------------------------------------------------------------
BETTER_AUTH_GOOGLE_ID=
BETTER_AUTH_GOOGLE_SECRET=
BETTER_AUTH_GITHUB_ID=
BETTER_AUTH_GITHUB_SECRET=

# ---------------------------------------------------------------------------
# Object storage (Cloudflare R2 / S3)    [required]
# ---------------------------------------------------------------------------
S3_ACCOUNT_ID=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=
S3_PUBLIC_DOMAIN=

# ---------------------------------------------------------------------------
# Payments (Midtrans)
# ---------------------------------------------------------------------------
# [required]
MIDTRANS_SERVER_KEY=
MIDTRANS_CLIENT_KEY=
MIDTRANS_MERCHANT_ID=
MIDTRANS_ENVIRONMENT=sandbox

# ---------------------------------------------------------------------------
# Transactional email (Eusend, optional)
# Delivery failures are logged, never thrown, so auth flows keep working.
# ---------------------------------------------------------------------------
EUSEND_API_KEY=
EUSEND_FROM=

# ---------------------------------------------------------------------------
# Billing cron (optional; without it the cron route needs an admin session)
# ---------------------------------------------------------------------------
BILLING_CRON_SECRET=

# ---------------------------------------------------------------------------
# Usage metering
# ---------------------------------------------------------------------------
# soft (default) or hard
USAGE_QUOTA_ENFORCEMENT=soft
# In-process rollup flush interval in seconds; 0 disables it.
USAGE_FLUSH_INTERVAL_SECONDS=0

# ---------------------------------------------------------------------------
# AI feature clients                     [feature]
# The API imports these clients at boot; missing values stop startup.
# ---------------------------------------------------------------------------
ELEVENLABS_API_KEY=
TIKTOK_TIKWM_BASE_URL=
TIKTOK_TIKWM_APIKEY=
MTXX_SDK_BASE_URL=
MTXX_OPENAPI_BASE_URL=
MTXX_KEY=
MTXX_SECRET=
MTXX_APP_VERSION=12.11.5
CAI_USER_TOKEN=
CAI_NEO_BASE_URL=

# Optional: Remini routes fail on first call when unset.
REMINI_API_BASE_URL=
REMINI_WSS_BASE_URL=
