{
	"name": "proxy",
	"version": "1.0.0",
	"author": "FrierenDv",
	"private": true,
	"type": "module",
	"license": "MIT",
	"description": "Server proxy",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/frierendv/itsrose.git"
	},
	"bugs": "https://github.com/frierendv/itsrose/issues",
	"homepage": "https://github.com/frierendv/itsrose#readme",
	"exports": {
		"./app": "./dist/app.mjs",
		"./main": "./dist/main.mjs",
		"./plugins/helmet": "./dist/plugins/helmet.mjs",
		"./plugins/tracking": "./dist/plugins/tracking.mjs",
		"./plugins/xml": "./dist/plugins/xml.mjs",
		"./proxy/test": "./dist/proxy/test.mjs",
		"./utils": "./dist/utils/index.mjs",
		"./utils/handle-response": "./dist/utils/handle-response.mjs",
		"./package.json": "./package.json",
		".": "./main.mjs"
	},
	"scripts": {
		"build": "tsdown",
		"dev": "tsx src/server.ts",
		"format": "prettier --write .",
		"lint": "eslint . --ext .ts",
		"start": "node dist/server.js"
	},
	"dependencies": {
		"@fastify/autoload": "^6.5.0",
		"@fastify/helmet": "^13.1.0",
		"@fastify/http-proxy": "^11.6.0",
		"@itsrose/fastify-utils": "workspace:*",
		"@itsrose/http-code": "workspace:*",
		"@itsrose/logger": "workspace:*",
		"fast-xml-builder": "^1.3.0",
		"fastify": "^5.11.2",
		"fastify-plugin": "^6.0.0"
	},
	"devDependencies": {
		"@itsrose/eslint-config": "workspace:*",
		"@itsrose/tsdown-config": "workspace:*",
		"@itsrose/typescript-config": "workspace:*"
	},
	"publishConfig": {
		"exports": {
			"./app": "./dist/app.mjs",
			"./main": "./dist/main.mjs",
			"./plugins/helmet": "./dist/plugins/helmet.mjs",
			"./plugins/tracking": "./dist/plugins/tracking.mjs",
			"./plugins/xml": "./dist/plugins/xml.mjs",
			"./proxy/test": "./dist/proxy/test.mjs",
			"./utils": "./dist/utils/index.mjs",
			"./utils/handle-response": "./dist/utils/handle-response.mjs",
			"./package.json": "./package.json"
		}
	}
}
