# ItsRose dashboard environment
#
# Every NEXT_PUBLIC_* value is inlined by `next build`/`next dev`, so set it
# before building; runtime container env cannot change it afterwards.
# Docker: the dashboard image takes these as build args (see
# docker/web-dashboard/compose.yml); runtime env_file cannot change them.

# Public origin of the dashboard (metadata, canonical URLs, auth cookie base).
NEXT_PUBLIC_APP_BASE_URL=http://localhost:3000

# Better Auth API origin. Point this at the API when it runs on another port
# or host; it defaults to the dashboard origin.
NEXT_PUBLIC_AUTH_BASE_URL=http://localhost:3000

# Branding
NEXT_PUBLIC_APP_NAME=ItsRose
NEXT_PUBLIC_APP_TITLE=ItsRose Platform
NEXT_PUBLIC_APP_DESCRIPTION=ItsRose provide you an easy to integrate APIs.

# Optional author links in metadata
NEXT_PUBLIC_AUTHOR_GITHUB_TITLE=
NEXT_PUBLIC_AUTHOR_GITHUB_URL=
