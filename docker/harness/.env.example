# Container hostname
CONTAINER_HOSTNAME=itsrose

# Gateway port exposed by the container / Caddy reverse proxy
GATEWAY_PORT=8080

# Host bind interface for local testing (e.g. 127.0.0.1 for localhost, 0.0.0.0 for LAN)
GATEWAY_BIND=127.0.0.1

# Authority/domain expected by DeepSeek Harness / Cloudflare Zero Trust tunnel
# DSH_TRUSTED_HOST=harness.example.com

# Host directory to bind-mount as /workspace inside container
DSH_WORKSPACE=./workspace
